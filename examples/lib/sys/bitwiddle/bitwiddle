#!/usr/bin/bash
# bitwiddle - Apply bitwise operations (OR, AND, XOR) to each byte of a string.

bitwiddle() {
  # Not VERSION/SCRIPT_NAME: a caller with those readonly (BCS metadata)
  # would make these local declarations fail
  local -r _bw_version=1.0.0
  local -- _bw_name=${FUNCNAME[0]}
  # Helpers are namespaced: nested functions become global on first call
  _bw_help() {
    [[ $0 == bash ]] && return 0 ||:
    cat <<HELP
$_bw_name $_bw_version - Apply bitwise operations (OR, AND, XOR) to each byte of a string.

Usage: $_bw_name [OPTIONS] STRING OPERATION OPERAND

  STRING     Input string to process (use "-" for stdin).
  OPERATION  Bitwise operation: or, and, xor (case-insensitive).
  OPERAND    Byte value 0-255: decimal, 0x hex, or 0-prefixed octal.

Options:
  -x|--hex       Output as hex bytes (space-separated).
  -d|--decimal   Output as decimal values (space-separated).
  -V|--version   Print version and exit.
  -h|--help      Print this help and exit.

Examples:
  $_bw_name 'hello' xor 42
  $_bw_name -x 'hello' or 128
  echo -n 'secret' | $_bw_name - xor 0x55
  $_bw_name 'hello' xor 42 | $_bw_name - xor 42   # returns 'hello'
HELP
  }
  _bw_error() { >&2 printf "$_bw_name: ✗ %s\n" "${@:2}"; return "${1:-0}"; }

  local -- str='' op='' operand=''
  local -i hex=0 decimal=0
  while (($#)); do case $1 in
    -x|--hex)      hex=1 ;;
    -d|--decimal)  decimal=1 ;;
    -V|--version)  echo "$_bw_name $_bw_version"; return 0 ;;
    -h|--help)     _bw_help; return 0 ;;
    --)            shift; break ;;
    -[xdVh]?*)     set -- "${1:0:2}" "-${1:2}" "${@:2}"; continue ;;
    -?*)           _bw_error 22 "Invalid option ${1@Q}" || return ;;
    *)  if [[ -z $str ]]; then
          str=$1
        elif [[ -z $op ]]; then
          op=$1
        elif [[ -z $operand ]]; then
          operand=$1
        else
          _bw_error 2 "Unexpected argument ${1@Q}" || return
        fi
  esac; shift; done

  # Collect remaining positional args after --
  while (($#)); do
    if [[ -z $str ]]; then
      str=$1
    elif [[ -z $op ]]; then
      op=$1
    elif [[ -z $operand ]]; then
      operand=$1
    else
      _bw_error 2 "Unexpected argument ${1@Q}" || return
    fi
    shift
  done

  # Validate required arguments
  [[ -n $str && -n $op && -n $operand ]] \
      || _bw_error 2 "Requires STRING OPERATION OPERAND" || return

  # Validate operation
  case ${op,,} in
    or|and|xor) ;;
    *) _bw_error 22 "Invalid operation ${op@Q} (use: or, and, xor)" || return ;;
  esac

  # OPERAND reaches $(( )), where a subscript such as a[$(cmd)] would execute;
  # admit only literal forms arithmetic parses cleanly (08, 09 would not), short
  # enough not to overflow, then a byte range: above 255 the output is garbage
  [[ $operand =~ ^(0[xX][0-9a-fA-F]{1,2}|0[0-7]{0,3}|[1-9][0-9]{0,2})$ ]] && ((operand <= 255)) \
      || _bw_error 22 "Invalid operand ${operand@Q} (use 0-255: decimal, 0x hex or 0 octal)" || return

  # _bw_process: apply bitwise op to a stream of decimal byte values
  _bw_process() {
    local -i val
    while IFS= read -r val; do
      case ${op,,} in
        or)  val=$((val | operand)) ;;
        and) val=$((val & operand)) ;;
        xor) val=$((val ^ operand)) ;;
      esac
      if ((hex)); then
        printf '%02x ' "$val"
      elif ((decimal)); then
        printf '%d ' "$val"
      else
        #shellcheck disable=SC2059  # generated octal escape is the only way to emit a raw byte
        printf "\\$(printf '%03o' "$val")"
      fi
    done
    ((hex || decimal)) && echo ||:
  }

  if [[ $str == '-' ]]; then
    # Read stdin as numeric byte values via od — handles null bytes
    od -An -tu1 -v | xargs -n1 | _bw_process
  else
    # Convert string to numeric byte values
    local -i i
    local -- LC_ALL=C
    for ((i=0; i<${#str}; i+=1)); do
      printf '%d\n' "'${str:i:1}"
    done | _bw_process
  fi
}
declare -fx bitwiddle

[[ ${BASH_SOURCE[0]} == "$0" ]] || return 0

# --- Script mode only below ---
set -euo pipefail
shopt -s inherit_errexit
declare -rx PATH=/usr/local/bin:/usr/bin:/bin

bitwiddle "$@"
#fin
