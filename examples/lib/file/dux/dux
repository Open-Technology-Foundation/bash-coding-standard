#!/usr/bin/env bash
# dux - Quick directory size overview (sorted smallest to largest)
set -euo pipefail
shopt -s inherit_errexit shift_verbose extglob nullglob

# Lock down PATH for security
declare -rx PATH=/usr/local/bin:/usr/bin:/bin

declare -r VERSION=1.5.0
declare -r SCRIPT_NAME=${0##*/} # Script basename only

# Runtime flags
declare -i FOLLOW_SYMLINKS=0 ONE_FS=0 VERBOSE=1

# Core message functions
_msg() { >&2 printf "$SCRIPT_NAME: $1 %s\n" "${@:2}"; }
# Future expansion:
#info() { ((VERBOSE)) || return 0; _msg '◉' "$@"; }
error() { _msg '✗' "$@"; }
die() { (($# < 2)) || error "${@:2}"; exit "${1:-0}"; }

# --------------------------------------------------------------------------------
# Usage documentation
# --------------------------------------------------------------------------------
show_help() {
  cat <<HELP
$SCRIPT_NAME $VERSION - Quick directory size overview

Find out where your disk space is going. Shows the size of each subdirectory,
sorted smallest to largest (largest at bottom for easy viewing).

USAGE
  $SCRIPT_NAME [OPTIONS] [DIRECTORY]
  $SCRIPT_NAME -h | -V

OPTIONS
  -L                     Follow symlinks
  -x, --one-file-system  Stay on the target's filesystem
  -q, --quiet            Suppress permission errors
  -h, --help             Show this help
  -V, --version          Show version

EXAMPLES
  $SCRIPT_NAME              # Current directory
  $SCRIPT_NAME /var         # Check /var subdirectories
  $SCRIPT_NAME ~ | tail -5  # 5 largest in home directory
  sudo $SCRIPT_NAME /       # Full system (needs root)

OUTPUT
  <size>    <path>

  Sizes are apparent sizes (bytes of content, as du -b) in IEC units
  (KiB, MiB, GiB). Tab-separated for easy parsing.
  Permission errors go to stderr; accessible content is still shown.

EXIT CODES
  0   Success
  2   Usage error (too many arguments)
  3   Directory not found
  5   I/O error (du failure)
  22  Invalid option

More info: https://github.com/Open-Technology-Foundation/dux
HELP
}

# --------------------------------------------------------------------------------
# Size each directory given as an argument, in parallel.
# Usage: calc_sizes [DU_OPTION...] -- DIR...
# Emits NUL-terminated "<bytes>\t<path>" records in completion order.
# --------------------------------------------------------------------------------
calc_sizes() {
  local -a du_opts=()
  while [[ $1 != -- ]]; do du_opts+=("$1"); shift; done
  shift
  # One du per directory: a file hard-linked into several siblings counts in
  # full for each, where a single du over the whole tree would count it once.
  # du exits 1 on permission errors yet still emits a valid total (BCS0605);
  # xargs turns that into 123, so the caller validates the records instead.
  printf '%s\0' "$@" | xargs -0 -r -n1 -P"$(nproc)" du -sb "${du_opts[@]}" -0 -- ||:
}

# --------------------------------------------------------------------------------
# Main function
# --------------------------------------------------------------------------------
main() {
  local -a entries=() dirs=() sizes=()
  local -A sized=()
  local -- dir='' current_dir record entry root_dev
  local -i have_dir=0

  # Parse arguments
  while (($#)); do case $1 in
      -L)           FOLLOW_SYMLINKS=1 ;;
      -x|--one-file-system)
                    ONE_FS=1 ;;
      -q|--quiet)   VERBOSE=0 ;;
      -h|--help)    show_help; exit 0 ;;
      -V|--version) printf '%s %s\n' "$SCRIPT_NAME" "$VERSION"; exit 0 ;;
      --)           shift
                    (($#)) || break
                    ((have_dir == 0)) || die 2 "Too many arguments ${1@Q}"
                    dir=$1 have_dir=1
                    shift
                    (($# == 0)) || die 2 "Too many arguments ${1@Q}"
                    break ;;
      -[LxqhV]?*)   set -- "${1:0:2}" "-${1:2}" "${@:2}"; continue ;;
      -*)           die 22 "Invalid option ${1@Q}" ;;
      *)            ((have_dir == 0)) || die 2 "Too many arguments ${1@Q}"
                    dir=$1 have_dir=1 ;;
  esac; shift; done
  readonly -- FOLLOW_SYMLINKS ONE_FS VERBOSE

  # No operand means the current directory; an empty one ('') is a bad path
  ((have_dir)) || dir=./
  [[ -d $dir ]] || die 3 "Not a directory ${dir@Q}"

  # du echoes 'dir//' back as 'dir/' while find keeps 'dir//', and every du
  # record is matched to a find path below, so collapse them up front.
  while [[ $dir == *// ]]; do dir=${dir%/}; done

  # find has no '--' for start points: a leading '-', or a whole '(' or '!',
  # is read as an expression (BCS1005). A './' prefix makes the operand
  # literal for find and du alike.
  case $dir in -*|'('|'!') dir=./$dir ;; esac

  # Without -L, follow only a symlinked start path, as ls and du do for their
  # operands (find -H, du -D); subdirectory symlinks stay unlisted. With -L,
  # follow every symlink, in find and in du alike.
  local -- find_deref=-H
  local -a du_opts=(-D)
  if ((FOLLOW_SYMLINKS)); then
    find_deref=-L
    du_opts=(-L)
  fi
  ((ONE_FS == 0)) || du_opts+=(-x)

  # Collect target dir and immediate subdirectories (depth 0 + 1) as
  # '<device>\t<path>' entries; find lists the target first.
  # Stderr suppressed: permission errors on subtrees are non-fatal here.
  #bcscheck disable=BCS1005 # find rejects '--'; $dir is './'-prefixed above
  readarray -d '' -t entries < <(
    find "$find_deref" "$dir" -maxdepth 1 -type d -printf '%D\t%p\0' 2>/dev/null ||:)

  # Defensive: find should always emit at least $dir; empty result indicates
  # find failed entirely (e.g. dir vanished between -d check and exec).
  ((${#entries[@]})) || die 3 "No directories found in ${dir@Q}"

  # -x keeps only directories on the target's filesystem, as du -x does.
  # (find -xdev would still list the mount points themselves.)
  root_dev=${entries[0]%%$'\t'*}
  for entry in "${entries[@]}"; do
    ((ONE_FS == 0)) || [[ ${entry%%$'\t'*} == "$root_dev" ]] || continue
    dirs+=("${entry#*$'\t'}")
  done

  # -q silences du only; the script's own messages still reach stderr.
  if ((VERBOSE)); then
    readarray -d '' -t sizes < <(calc_sizes "${du_opts[@]}" -- "${dirs[@]}")
  else
    readarray -d '' -t sizes < <(calc_sizes "${du_opts[@]}" -- "${dirs[@]}" 2>/dev/null)
  fi

  # Every directory must come back with a record: du prints a total even
  # when it exits 1. A directory that has gone since find listed it (a /proc
  # PID, a temp dir) is simply left out; one still there is a real failure.
  for record in "${sizes[@]}"; do
    sized[${record#*$'\t'}]=1
  done
  for current_dir in "${dirs[@]}"; do
    [[ -z ${sized[$current_dir]:-} ]] || continue
    [[ -e $current_dir ]] || continue
    die 5 "Failed to calculate size for ${current_dir@Q}"
  done
  ((${#sizes[@]})) || die 3 "No directories found in ${dir@Q}"

  # Smallest first. One numfmt formats the whole stream; a fork per line
  # cost as much as the du calls themselves. C locale keeps the decimal
  # point a '.' (id_ID would print '1,5KB'), so the size column parses alike.
  printf '%s\0' "${sizes[@]}" \
    | sort -z -n \
    | LC_ALL=C numfmt -z -d $'\t' --field=1 --to=iec-i --suffix=B --format='%-10.1f' \
    | tr '\0' '\n'
}

main "$@"
#fin
