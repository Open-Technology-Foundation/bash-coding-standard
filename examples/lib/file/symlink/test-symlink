# Containment / Security Boundary Tests
# The .symlink source/link-name containment checks are the real security
# boundary when scanning untrusted trees as root. These exercise it directly.
#━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

test_containment_rejects_absolute_source() {
  # An absolute source must be refused (a hostile tree cannot publish a link to
  # an arbitrary system path).
  create_symlink_file "${TEST_SOURCE_DIR}/.symlink" "/etc/passwd evil"

  run_symlink_sudo -S -P -t "${TEST_TARGET_DIR}" "${TEST_SOURCE_DIR}" || true

  assert_file_not_exists "${TEST_TARGET_DIR}/evil"
