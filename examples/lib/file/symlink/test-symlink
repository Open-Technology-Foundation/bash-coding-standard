test_version_short() {
  local -- expected
  expected=$(sed -n -- 's/^declare -r VERSION=//p' "${SYMLINK_BIN}") \
    || { fail 'Cannot read symlink source'; return 1; }
  # Empty would make the assert_contains below pass vacuously
  [[ -n ${expected} ]] || { fail 'No VERSION line found in symlink'; return 1; }
  run_symlink -V
  assert_equals 0 "${TEST_EXIT_CODE}"
  assert_contains "${TEST_OUTPUT}" "${expected}"
}

