test_delete_broken_symlinks_flag() {
  local -r noop="${TEST_SOURCE_DIR}/noop.sh"
  create_mock_executable "${noop}"

  # Dry-run with -d must REPORT but NOT delete the broken symlink
  create_broken_symlink "${TEST_TARGET_DIR}/broken-link"
  run_symlink_sudo -d -n -t "${TEST_TARGET_DIR}" "${noop}"
  [[ -L "${TEST_TARGET_DIR}/broken-link" ]] || fail "dry-run -d deleted the broken symlink"

  # Real run with -d removes the broken symlink
  run_symlink_sudo -d -t "${TEST_TARGET_DIR}" "${noop}"
  [[ ! -L "${TEST_TARGET_DIR}/broken-link" ]] || fail "real -d did not delete the broken symlink"
}

