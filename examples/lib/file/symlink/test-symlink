  assert_symlink_to "${TEST_TARGET_DIR}/yfirst" "${TEST_SOURCE_DIR}/yfirst"
  [[ "${TEST_OUTPUT}" != *"does not exist"* ]] || fail ".symlink entry mangled by prompt read: ${TEST_OUTPUT}"
