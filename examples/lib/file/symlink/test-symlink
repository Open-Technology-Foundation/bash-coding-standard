# trace_file_from_output - echo the trace path the script logged to stderr.
# Parsing the actual path (not globbing /tmp) keeps these tests hermetic and
# immune to stale root-owned trace files from earlier runs.
trace_file_from_output() {
  grep -oE '/[^ )]*/symlink-trace-[A-Za-z0-9._-]+\.log' <<< "${TEST_OUTPUT}" | head -1
}

