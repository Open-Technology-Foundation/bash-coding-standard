#!/usr/bin/env bash
# shellcheck disable=SC2317,SC2329  # Functions invoked indirectly via test framework
# test-symlink - Comprehensive test suite for symlink script
# Version: 1.0.0
# License: GPL-3.0

set -euo pipefail
shopt -s inherit_errexit extglob nullglob
# Runs as root: never trust the caller's PATH (same value as symlink itself)
declare -rx PATH=/usr/local/bin:/usr/bin:/bin:/usr/local/sbin:/usr/sbin:/sbin

# Get script directory
SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd) \
  || { >&2 echo 'test-symlink: cannot determine script directory'; exit 1; }
readonly SCRIPT_DIR

# Source test framework and helpers (no die() exists yet, so exit directly)
[[ -f ${SCRIPT_DIR}/test-harness && -f ${SCRIPT_DIR}/test-helpers ]] \
  || { >&2 echo "test-symlink: test-harness/test-helpers not found in ${SCRIPT_DIR@Q}"; exit 3; }
# shellcheck source=./test-harness
source -- "${SCRIPT_DIR}/test-harness" \
  || { >&2 echo 'test-symlink: failed to source test-harness'; exit 1; }
# shellcheck source=./test-helpers
source -- "${SCRIPT_DIR}/test-helpers" \
  || { >&2 echo 'test-symlink: failed to source test-helpers'; exit 1; }

#━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Setup and Teardown
#━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# must CMD... - Run a fixture step; on failure, fail the test naming the step.
# run_test calls each test as an `if` condition, so errexit is suspended inside
# tests and an unchecked step would fail silently. Use as: must CMD || return 1
must() {
  "$@" && return 0
  fail "Fixture step failed: $*"
  return 1
}

setup() {
  setup_test_env
}

teardown() {
  cleanup_test_env
}

