test_replace_existing_regular_file() {
  local -r test_script="${TEST_SOURCE_DIR}/test.sh"
  create_mock_executable "${test_script}"

  # Create regular file in target
  echo "regular file" > "${TEST_TARGET_DIR}/test.sh" \
    || { fail 'Cannot write fixture file'; return 1; }

  # Replace with symlink — non-interactive replacement requires --force
  run_symlink_sudo -P --force -t "${TEST_TARGET_DIR}" "${test_script}"

  assert_symlink_to "${TEST_TARGET_DIR}/test.sh" "${test_script}"
}

test_skip_existing_regular_file_without_force() {
  local -r test_script="${TEST_SOURCE_DIR}/test.sh"
  create_mock_executable "${test_script}"

  # Pre-existing non-symlink file must NOT be clobbered without --force
  echo "regular file" > "${TEST_TARGET_DIR}/test.sh" \
    || { fail 'Cannot write fixture file'; return 1; }

  run_symlink_sudo -P -t "${TEST_TARGET_DIR}" "${test_script}"

  # Still a regular file with original content, not a symlink
  assert_file_exists "${TEST_TARGET_DIR}/test.sh"
  [[ ! -L "${TEST_TARGET_DIR}/test.sh" ]] || fail "non-symlink file was clobbered without --force"
  assert_contains "$(cat -- "${TEST_TARGET_DIR}/test.sh")" "regular file"
}

test_backup_replace_regular_file() {
  local -r test_script="${TEST_SOURCE_DIR}/test.sh"
  create_mock_executable "${test_script}"

  echo "regular file" > "${TEST_TARGET_DIR}/test.sh" \
    || { fail 'Cannot write fixture file'; return 1; }

  # --backup preserves the clobbered file as NAME.bak~
  run_symlink_sudo -P --force --backup -t "${TEST_TARGET_DIR}" "${test_script}"

  assert_symlink_to "${TEST_TARGET_DIR}/test.sh" "${test_script}"
  assert_file_exists "${TEST_TARGET_DIR}/test.sh.bak~"
  assert_contains "$(cat -- "${TEST_TARGET_DIR}/test.sh.bak~")" "regular file"
}

