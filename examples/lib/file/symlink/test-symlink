  assert_not_empty "${trace_file}" "Trace file should exist"
  local trace_content
  trace_content=$(cat -- "${trace_file}") \
    || { fail "Cannot read trace file ${trace_file@Q}"; return 1; }
  assert_contains "${trace_content}" "TRACE: Script started"
  assert_contains "${trace_content}" "TRACE: Execution completed"
}

