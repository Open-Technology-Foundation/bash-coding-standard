# Elevation env-drop contract (M9/M10). A live non-root re-exec test would need
# an unprivileged user with passwordless sudo, which is environment-specific and
# fragile; instead assert the hardening directly on the source: the elevation
# must forward only SYMLINK_DEBUG and must NOT use `sudo -E` (which would carry
# SYMLINK_FORCE_CRITICAL across the privilege boundary unvalidated).
test_elevation_does_not_forward_force_critical() {
  local -- elevation_line
  # Single quotes are intentional: the regex must match a literal $0 in the source.
  # shellcheck disable=SC2016
  elevation_line="$(grep -nE -- '^[[:space:]]*sudo .*"\$0"' "${SYMLINK_BIN}")"
  assert_not_empty "${elevation_line}"
  assert_contains "${elevation_line}" 'SYMLINK_DEBUG='
  # Must NOT preserve the full environment across elevation.
  [[ "${elevation_line}" != *'sudo -E'* ]] \
    || fail "elevation uses 'sudo -E' — would leak SYMLINK_FORCE_CRITICAL across privilege boundary"
  # Must NOT explicitly forward the critical-file override.
  [[ "${elevation_line}" != *'SYMLINK_FORCE_CRITICAL'* ]] \
    || fail "elevation forwards SYMLINK_FORCE_CRITICAL across privilege boundary"
}

