# Markdown parser functions
# Render collected footnotes at end of document
render_footnotes() {
  local -- ref_id footnote_text formatted_text

  echo
  printf '%s%s%s\n' "$COLOR_H2" 'Footnotes:' "$ANSI_RESET"
  echo

  for ref_id in "${FOOTNOTE_REFS[@]}"; do
    if [[ -n ${FOOTNOTES[$ref_id]:-} ]]; then
      footnote_text=${FOOTNOTES[$ref_id]}
      formatted_text=$(colorize_line "$footnote_text")
      printf '%s[%s%s^%s%s%s]: %s%s\n' \
        "$COLOR_TEXT" \
        "$ANSI_BOLD" "$ANSI_DIM" "$ref_id" "$ANSI_RESET" "$COLOR_TEXT" \
        "$formatted_text" \
        "$ANSI_RESET"
    else
      printf '%s[%s%s^%s%s%s]: %sMissing footnote definition%s\n' \
        "$COLOR_TEXT" \
        "$ANSI_BOLD" "$ANSI_DIM" "$ref_id" "$ANSI_RESET" "$COLOR_TEXT" \
        "$ANSI_ITALIC" \
        "$ANSI_RESET"
    fi
  done
}

# Parse markdown line array and produce ANSI output
# Usage: parse_markdown lines_array_name
parse_markdown() {
  local -n _lines=$1
  local -i i=0
  local -- line original_line

  # Reset parsing state
  IN_CODE_BLOCK=0
  CODE_FENCE_TYPE=''
  CODE_LANG=''
  FOOTNOTES=()
  FOOTNOTE_REFS=()

  local -- fence lang_spec
  local -- formatted_line quote_content
  local -- hashes header_text
  local -- indent status task_content list_content number
  local -- footnote_id footnote_text
  local -- ref_id ref_match
  local -a wrapped
  while ((i < ${#_lines[@]})); do
    line=${_lines[i]}
    original_line=$line

    # Trim trailing whitespace
    line=${line%"${line##*[![:space:]]}"}

    # CODE BLOCKS - Fenced (``` or ~~~)
    # Use literal backticks in regex
    if [[ $line =~ ^(\`\`\`|~~~)(.*)$ ]]; then
      fence=${BASH_REMATCH[1]}
      lang_spec=${BASH_REMATCH[2]}
      lang_spec=${lang_spec## }  # Trim leading spaces
      lang_spec=${lang_spec%% }  # Trim trailing spaces

      if ((IN_CODE_BLOCK)); then
        if [[ $fence == "$CODE_FENCE_TYPE" ]]; then
          # Closing fence (must match opening fence type per CommonMark)
          printf '%s%s%s\n' "$COLOR_CODEBLOCK" "$fence" "$ANSI_RESET"
          IN_CODE_BLOCK=0
          CODE_FENCE_TYPE=''
          CODE_LANG=''
        else
          # Mismatched fence inside code block — render as code content
          render_code_line "$line" "$CODE_LANG"
        fi
      else
        # Opening fence
        IN_CODE_BLOCK=1
        CODE_FENCE_TYPE=$fence
        CODE_LANG=$lang_spec
        printf '%s%s' "$COLOR_CODEBLOCK" "$fence"
        [[ -z $lang_spec ]] || printf ' %s' "$lang_spec"
        printf '%s\n' "$ANSI_RESET"
      fi
      i+=1
      continue
    fi

    # Inside code block - render code lines
    if ((IN_CODE_BLOCK)); then
      render_code_line "$line" "$CODE_LANG"
      i+=1
      continue
    fi

    # TABLES - two or more consecutive lines starting with |. A lone pipe line,
    # or any with tables disabled, falls through and renders as regular text
    # (render_table would otherwise return 1 and set -e would end the run).
    if ((OPTIONS[tables])) \
        && [[ $line =~ ^[[:space:]]*\| && ${_lines[i+1]:-} =~ ^[[:space:]]*\| ]]; then
      render_table _lines i
      # render_table updates i to next line after table
      continue
    fi

    # HORIZONTAL RULES: --- / === / ___
    if [[ $line =~ ^[[:space:]]*([-_=])\1{2,}[[:space:]]*$ ]]; then
      render_hr "$TERM_WIDTH"
      i+=1
      continue
    fi

    # BLOCKQUOTES: Lines starting with >
    if [[ $line =~ ^[[:space:]]*\>[[:space:]]?(.*)$ ]]; then
      quote_content=${BASH_REMATCH[1]}
      render_blockquote "$quote_content" "$TERM_WIDTH"
      i+=1
      continue
    fi

    # HEADERS: # through ######
    if [[ $line =~ ^(#{1,6})[[:space:]]+(.+)$ ]]; then
      hashes=${BASH_REMATCH[1]}
      header_text=${BASH_REMATCH[2]}
      render_header "$hashes" "$header_text"
      i+=1
      continue
    fi

    # TASK LISTS: - [ ] or - [x]
    if [[ $line =~ ^([[:space:]]*)[-*][[:space:]]+\[([[:space:]x])\][[:space:]]+(.+)$ ]]; then
      indent=${BASH_REMATCH[1]}
      status=${BASH_REMATCH[2]}
      task_content=${BASH_REMATCH[3]}

      if ((OPTIONS[task_lists])); then
        render_task_item "$indent" "$status" "$task_content" "$TERM_WIDTH"
      else
        # Treat as regular list with checkbox as part of content
        render_list_item "$indent" "[$status] $task_content" "$TERM_WIDTH"
      fi
      i+=1
      continue
    fi

    # UNORDERED LISTS: - or *
    if [[ $line =~ ^([[:space:]]*)[-*][[:space:]]+(.+)$ ]]; then
      indent=${BASH_REMATCH[1]}
      list_content=${BASH_REMATCH[2]}
      render_list_item "$indent" "$list_content" "$TERM_WIDTH"
      i+=1
      continue
    fi

    # ORDERED LISTS: 1. 2. etc.
    if [[ $line =~ ^([[:space:]]*)([0-9]+)\.[[:space:]]+(.+)$ ]]; then
      indent=${BASH_REMATCH[1]}
      number=${BASH_REMATCH[2]}
      list_content=${BASH_REMATCH[3]}
      render_ordered_item "$indent" "$number" "$list_content" "$TERM_WIDTH"
      i+=1
      continue
    fi

    # FOOTNOTE DEFINITIONS: [^id]: text
    if [[ $line =~ ^\[\^([^]]+)\]:[[:space:]]+(.+)$ ]] && ((OPTIONS[footnotes])); then
      footnote_id=${BASH_REMATCH[1]}
      footnote_text=${BASH_REMATCH[2]}
      FOOTNOTES[$footnote_id]=$footnote_text

      # Track reference order
      if [[ " ${FOOTNOTE_REFS[*]} " != *" $footnote_id "* ]]; then
        FOOTNOTE_REFS+=("$footnote_id")
      fi

      # Skip rendering this line
      i+=1
      continue
    fi

    # EMPTY LINES
    if [[ -z $line ]]; then
      echo
      i+=1
      continue
    fi

    # REGULAR TEXT - with inline formatting
    # Find and track footnote references in text
    if ((OPTIONS[footnotes])); then
      while [[ $line =~ \[\^([^]]+)\] ]]; do
        ref_id=${BASH_REMATCH[1]}
        ref_match=${BASH_REMATCH[0]}
        if [[ " ${FOOTNOTE_REFS[*]} " != *" $ref_id "* ]]; then
          FOOTNOTE_REFS+=("$ref_id")
        fi
        # Blank out the match: quoted, so [^1] is literal text rather than a glob,
        # and a space, so deleting it cannot join '[' and '^x]' into a new reference
        line=${line/"$ref_match"/ }
      done
      line=$original_line  # Restore for colorization
    fi

    formatted_line=$(colorize_line "$line")
    readarray -t wrapped < <(wrap_text "${COLOR_TEXT}${formatted_line}" "$TERM_WIDTH")

    printf '%s\n' "${wrapped[@]}"
    i+=1
  done

  if ((OPTIONS[footnotes])) && ((${#FOOTNOTES[@]})) && ((${#FOOTNOTE_REFS[@]})); then
    render_footnotes
  fi
}

