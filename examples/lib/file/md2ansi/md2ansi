# Main script functions
# Usage documentation
show_help() {
  cat <<HELP
$SCRIPT_NAME $VERSION - Convert Markdown to ANSI-colored terminal output

A zero-dependency Bash implementation that renders markdown files with color
and style directly in your terminal.

Usage: $SCRIPT_NAME [OPTIONS] [file1.md [file2.md ...]]
       cat README.md | $SCRIPT_NAME
       curl -s https://example.com/file.md | $SCRIPT_NAME

Options:
  -h, --help              Show this help message and exit
  -V, --version           Show version information and exit
  -D, --debug             Enable debug mode with detailed traces (to stderr)
  -w, --width WIDTH       Force specific terminal width (default: auto-detect)
  -t, --plain             Disable all formatting features (every --no-*
                          option below); colors remain, TERM=dumb removes them

Feature Toggles:
  --no-footnotes          Disable footnotes processing
  --no-syntax-highlight   Disable syntax highlighting in code blocks
  --no-tables             Disable table formatting
  --no-task-lists         Disable task list (checkbox) formatting
  --no-images             Disable image placeholders
  --no-links              Disable link formatting

Examples:
  # View a markdown file with pager
  $SCRIPT_NAME README.md | less -R

  # Process multiple files
  $SCRIPT_NAME *.md

  # Process from stdin
  cat doc.md | $SCRIPT_NAME

  # Force specific width
  $SCRIPT_NAME --width 100 README.md

  # Disable specific features
  $SCRIPT_NAME --no-tables --no-syntax-highlight doc.md

  # Disable all formatting features (colors remain)
  $SCRIPT_NAME --plain README.md

  # No ANSI codes at all, e.g. for a log file
  TERM=dumb $SCRIPT_NAME README.md > output.txt

Security:
  - Files larger than 10MB are rejected for safety
  - Input from stdin is also limited to 10MB
  - ANSI escape sequences in input are sanitized

For more information, see: https://github.com/Open-Technology-Foundation/md2ansi.bash
HELP
}

# Argument parsing
#bcscheck disable=BCS0804  # kept in its own function; main() calls it first, then sets readonly
parse_arguments() {
  while (($#)); do
    case $1 in
      -w|--width)
        noarg "$@"
        shift
        # Decimal, not octal for a leading 0 (08 fails, 040 is 32); nine digits cannot overflow
        [[ $1 =~ ^[0-9]{1,9}$ ]] || die 22 "Invalid width ${1@Q}"
        TERM_WIDTH=$((10#$1))
        ((TERM_WIDTH >= 20 && TERM_WIDTH <= 500)) || die 22 "Width ${1@Q} must be between 20 and 500"
        ;;
      -D|--debug)
        DEBUG=1
        ;;
      -V|--version)
        echo "$SCRIPT_NAME $VERSION"
        exit 0
        ;;
      -h|--help)
        show_help
        exit 0
        ;;
      -t|--plain)
        # Feature toggles only: colors follow the terminal check (TERM=dumb for none)
        OPTIONS[footnotes]=0
        OPTIONS[syntax_highlight]=0
        OPTIONS[tables]=0
        OPTIONS[task_lists]=0
        OPTIONS[images]=0
        OPTIONS[links]=0
        ;;
      --no-footnotes)
        OPTIONS[footnotes]=0
        ;;
      --no-syntax-highlight)
        OPTIONS[syntax_highlight]=0
        ;;
      --no-tables)
        OPTIONS[tables]=0
        ;;
      --no-task-lists)
        OPTIONS[task_lists]=0
        ;;
      --no-images)
        OPTIONS[images]=0
        ;;
      --no-links)
        OPTIONS[links]=0
        ;;

      --)
        shift
        (($#==0)) || INPUT_FILES+=("$@")
        break
        ;;
      -[wDVht]?*) # Bundled short options
        set -- "${1:0:2}" "-${1:2}" "${@:2}"
        continue
        ;;

      -*)
        die 22 "Invalid option ${1@Q}"
        ;;
      *)
        INPUT_FILES+=("$1")
        ;;
    esac
    shift
  done
}

# Process a single file or stdin
process_file() {
  local -- filepath=${1:-}
  local -a lines=()
  local -- line

  if [[ -n $filepath ]]; then
    debug "Processing file ${filepath@Q}"
    validate_file_size "$filepath" "$MAX_FILE_SIZE"

    while IFS= read -r line || [[ -n $line ]]; do
      # Skip shebang to prevent treating it as markdown content
      if ((${#lines[@]} == 0)) && [[ $line =~ ^\#! ]]; then
        continue
      fi
      lines+=("$line")
    done < <(sanitize_input "$filepath")
  else
    debug 'Processing stdin'
    local -i byte_count=0

    # stdin has no size to stat, so the limit is enforced while reading
    while IFS= read -r line || [[ -n $line ]]; do
      byte_count+=${#line}
      byte_count+=1  # Account for newline

      if ((byte_count > MAX_FILE_SIZE)); then
        die 9 "Input from stdin exceeds maximum size: $MAX_FILE_SIZE bytes (10MB)"
      fi

      # Skip shebang to prevent treating it as markdown content
      if ((${#lines[@]} == 0)) && [[ $line =~ ^\#! ]]; then
        continue
      fi
      lines+=("$line")
    done < <(sanitize_input)
  fi

  debug "Read ${#lines[@]} lines"
  parse_markdown lines
}

main() {
  parse_arguments "$@"
  ((TERM_WIDTH)) || TERM_WIDTH=$(get_terminal_width)

  readonly TERM_WIDTH
  readonly -A OPTIONS
  readonly -a INPUT_FILES

  local -- opts=${OPTIONS[*]@A}
  debug "Terminal width: $TERM_WIDTH" "Options: ${opts#declare -* }"

  # Print initial reset to ensure clean terminal state
  printf '%s' "$ANSI_RESET"

  if ((${#INPUT_FILES[@]})); then
    local -- file
    for file in "${INPUT_FILES[@]}"; do
      process_file "$file"

      if ((${#INPUT_FILES[@]}>1)); then
        echo
      fi
    done
  else
    # Read from stdin
    process_file ''
  fi

  # Ensure terminal colors are reset at the end
  printf '%s' "$ANSI_RESET"

  return 0
}

# Script invocation
main "$@"
#fin
