#!/usr/bin/env bash
#shellcheck disable=SC2015  # BCS pattern: ((cond)) && action ||:
# cln - Recursively clean temporary and junk files from directories
#
# Searches for and removes common editor backup files, crash files,
# and other temporary files that accumulate in working directories.
set -euo pipefail
shopt -s inherit_errexit extglob nullglob

declare -rx PATH=/usr/local/bin:/usr/bin:/bin

declare -r VERSION=1.1.0
#shellcheck disable=SC2155  # accepted: declare masks realpath's exit status (BCS0103)
declare -r SCRIPT_PATH=$(realpath -- "$0")
declare -r SCRIPT_NAME=${SCRIPT_PATH##*/}

# Default file patterns
declare -a DELETE_FILES=('*~' '~*' '.~*' '.*~' DEADJOE dead.letter 'wget-log*')

# Messaging system
declare -i VERBOSE=1 PROMPT=1
# Color detection
if [[ -t 1 && -t 2 ]]; then
  declare -r RED=$'\033[0;31m' YELLOW=$'\033[0;33m' CYAN=$'\033[0;36m' NC=$'\033[0m'
else
  declare -r RED='' YELLOW='' CYAN='' NC=''
fi

_msg() { >&2 printf "$SCRIPT_NAME: $1 %s\n" "${@:2}"; }
error() { _msg "$RED✗$NC" "$@"; }
die() { (($# < 2)) || error "${@:2}"; exit "${1:-0}"; }
# Optional:
warn() { _msg "$YELLOW▲$NC" "$@"; }
info() { ((VERBOSE)) || return 0; _msg "$CYAN◉$NC" "$@"; }
yn() {
  local -- REPLY
  >&2 printf '%s ' "$SCRIPT_NAME: $YELLOW▲$NC ${1:-Continue?} y/n "
  read -r -n 1
  >&2 echo
  [[ ${REPLY,,} == y ]]
}

show_help() {
  cat <<HELP
$SCRIPT_NAME $VERSION - Search for and delete junk/trash/rubbish files.

Recursively removes all temporary/junk files.

The following filespecs are removed by default:

  ( ${DELETE_FILES[*]} )

Config files (first found wins):
  \$XDG_CONFIG_HOME/cln/cln.conf  (user override, default ~/.config)
  /etc/cln/cln.conf               (system config)
  /etc/cln.conf                   (system config, flat)
  /etc/default/cln                (system default)
  /usr/local/etc/cln/cln.conf     (local install)

Usage: $SCRIPT_NAME [Options] [path ...]

  'path' is a directory path to clean up. Default '.'

Options:
  -L                Follow symbolic links during search
  -a|--add SPEC     Add file pattern to cleanup scan; can be used
                    multiple times; SPEC can be comma-delimited
  -S|--set SPEC     Set/replace all file patterns (overrides config)
  -m|--depth N      Maximum directory depth to recurse (-1 = unlimited)
                    Default: 3
  -p|-n|--prompt    Prompt before deleting (default)
  -P|-N|--no-prompt Delete files without prompting
  -v|--verbose      Increase output verbosity
  -q|--quiet        Suppress output
  -V|--version      Show version
  -h|--help         Show this help

Examples:
  # 0) Remove all temporary files in current dir, with prompting.
  $SCRIPT_NAME

  # 1) Remove all temporary files in /home/foobar, with prompting.
  $SCRIPT_NAME /home/foobar

  # 2) Clean all temporary files quietly without prompting to
  #    max depth of 7.
  $SCRIPT_NAME -Pqm 7 /home/foobar /home/barfoo

  # 3) Clean all temporary files without prompting to max
  #    depth of 7 including .bak and .tmp files.
  $SCRIPT_NAME -Pqm 7 -a '*.bak,*.tmp' /home/foobar /home/barfoo
HELP
}

# Validate option has argument
# usage: noarg "$@"; shift # will die if no arg
noarg() { (($# > 1)) || die 22 "Option ${1@Q} requires an argument"; }

# Print variable as name=value (help display & debug)
decp() { declare -p "$@" 2>/dev/null | sed 's/^declare -[a-zA-Z-]* //'; }

# English numeric pluralization helper: returns 's' if count != 1
# usage: s "${#oranges[@]}"
s() { (( ${1:-1} == 1 )) || echo -n 's'; }

# Load patterns from config file if exists (BCS0111 search order)
read_conf() {
  local -- conf_file
  local -a search_paths=(
    "${XDG_CONFIG_HOME:-$HOME/.config}/cln/cln.conf"
    /etc/cln/cln.conf
    /etc/cln.conf
    /etc/default/cln
    /usr/local/etc/cln/cln.conf
  )
  for conf_file in "${search_paths[@]}"; do
    if [[ -f $conf_file && -r $conf_file ]]; then
      readarray -t DELETE_FILES < <(grep -vE '^[[:space:]]*(#|$)' "$conf_file")
      return 0
    fi
  done
  return 1
}

main() {
  # Load config file if exists (user or system)
  read_conf ||:

  # Default configurations
  local -a add_specs=()
  local -i max_depth=3
  local -- path
  local -a paths=()
  local -a rm_opts=(-f)
  local -- spec
  local -a all_specs=() add_specs_raw=() set_specs_raw=()
  local -a found_files=()
  local -i fnd=0
  local -a find_expr=()
  local -a symbolic=(-P)

  while (($#)); do case $1 in
    -L)           symbolic=(-L) ;;
    -a|--add)     noarg "$@"; shift
                  IFS=',' read -ra add_specs_raw <<< "$1"
                  for spec in "${add_specs_raw[@]}"; do
                    spec="${spec#"${spec%%[![:blank:]]*}"}"; spec="${spec%"${spec##*[![:blank:]]}"}"
                    [[ -z $spec ]] || add_specs+=("$spec")
                  done
                  ;;
    -S|--set)     noarg "$@"; shift
                  set_specs_raw=()
                  IFS=',' read -ra set_specs_raw <<< "$1"
                  DELETE_FILES=()
                  for spec in "${set_specs_raw[@]}"; do
                    spec="${spec#"${spec%%[![:blank:]]*}"}"; spec="${spec%"${spec##*[![:blank:]]}"}"
                    [[ -z $spec ]] || DELETE_FILES+=("$spec")
                  done
                  ;;
    -m|--depth)   noarg "$@"; shift
                  [[ $1 =~ ^-?[0-9]+$ ]] || die 22 "Option '-m|--depth' requires a numeric argument, got ${1@Q}"
                  max_depth=$1
                  ((max_depth != -1)) || max_depth=255
                  ;;
    #bcscheck disable=BCS0806  # -n/-N mean prompt here, not dry-run
    -p|-n|--prompt)
                  PROMPT=1; VERBOSE=1 ;;
    #bcscheck disable=BCS0806  # -n/-N mean prompt here, not dry-run
    -P|-N|--no-prompt)
                  PROMPT=0 ;;
    -v|--verbose) ((VERBOSE < 3)) && VERBOSE+=1 ||:  ;;
    -q|--quiet)   VERBOSE=0 ;;

    -V|--version) printf '%s %s\n' "$SCRIPT_NAME" "$VERSION"; exit 0 ;;
    -h|--help)    show_help; exit 0 ;;

    --)           shift; paths+=("$@"); break ;;

    -[LaSmpPNnvqVh]?*)
                  set -- "${1:0:2}" "-${1:2}" "${@:2}"; continue ;;

    -*)           die 22 "Invalid option ${1@Q}" ;;
    *)            paths+=("$1") ;;
  esac; shift; done

  # Set default path if not provided
  ((${#paths[@]})) || paths=('.')
  ((PROMPT && !VERBOSE)) && VERBOSE=1 ||:
  readonly VERBOSE PROMPT

  ((VERBOSE)) && rm_opts+=(-v) ||:

  # Combine default and additional specs
  all_specs=("${DELETE_FILES[@]}" "${add_specs[@]}")
  ((${#all_specs[@]})) || die 22 'No file patterns specified'

  # Build find criteria
  for spec in "${all_specs[@]}"; do
    find_expr+=(-name "$spec" -o)
  done
  # Remove the last -o
  unset 'find_expr[-1]'

  local -- file
  for path in "${paths[@]}"; do
    if [[ ! -d $path ]]; then
      warn "${path@Q} is not a directory. Skipping."
      continue
    fi
    info "Searching directory ${path@Q}, depth $max_depth"
    ((VERBOSE > 1)) && info "$(decp find_expr)" ||:
    # First find matching files and store in array
    readarray -t found_files < <(
        find "${symbolic[@]}" "$path" \
            -maxdepth "$max_depth" \
            -type f \
            \( "${find_expr[@]}" \) \
            -print \
            2>/dev/null ||:
          )
    fnd=${#found_files[@]}
    # Handle readarray quirk: single empty element means no results
    ((fnd == 1)) && [[ -z ${found_files[0]} ]] && fnd=0 ||:
    if ((fnd)); then
      if ((PROMPT)); then
        warn "Found $fnd file$(s $fnd) to remove:"
        for file in "${found_files[@]}"; do
          warn "${file@Q}"
        done
        yn "Remove $fnd file$(s $fnd)?" || continue
      fi
      info "Removing $fnd file$(s $fnd)..."
      rm "${rm_opts[@]}" -- "${found_files[@]}" || warn 'Some files could not be removed'
    else
      info "No matching files found in ${path@Q}"
    fi
  done
}

main "$@"
#fin
