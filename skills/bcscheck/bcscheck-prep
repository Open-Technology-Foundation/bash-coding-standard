#!/usr/bin/env bash
# Prepare a bcscheck run: rules extract, one context file per target, cache status
set -euo pipefail
shopt -s inherit_errexit shift_verbose extglob nullglob

declare -rx PATH=/usr/local/bin:/usr/bin:/bin
declare -r VERSION=1.0.0
declare -r SCRIPT_NAME=${0##*/}
declare -r CACHE_DIR=${XDG_CACHE_HOME:-$HOME/.cache}/bcscheck

# Options, read-only after parsing
declare -- OUT_DIR='' SINCE='' MODE=core
# SHA-256 of the rules file, set once in main
declare -- RULES_SHA=''

error() { >&2 printf '%s: ✗ %s\n' "$SCRIPT_NAME" "$*"; }
warn()  { >&2 printf '%s: ▲ %s\n' "$SCRIPT_NAME" "$*"; }
die() {
  (($# < 2)) || error "${*:2}"
  exit "${1:-0}"
}
noarg() { (($# > 1)) || die 22 "Option ${1@Q} requires an argument"; }

usage() {
  cat <<EOT
$SCRIPT_NAME $VERSION - prepare a bcscheck run

Usage: $SCRIPT_NAME -o DIR [-f] [-s REF] FILE...

Writes the rules file and one context file per target to DIR, then prints a
tab-separated manifest. Status per target:
  HIT   a report for this exact content, rules and mode is cached
  DIFF  changed since REF, and REF's report is cached: audit the diff only
  MISS  full audit needed
  SKIP  not a Bash file

Options:
  -o, --out DIR     Output directory (required)
  -f, --full        All rule tiers; the default is core rules only
  -s, --since REF   Git ref for diff-only re-audits
  -h, --help        Show this help
  -V, --version     Show the version

Cache: $CACHE_DIR
EOT
}

# Print the standard's path; same search order as the original skill
find_standard() {
  local -- dir
  for dir in ./data /usr/local/share/yatti/BCS/data /usr/share/yatti/BCS/data; do
    if [[ -f $dir/BASH-CODING-STANDARD.md ]]; then
      realpath -- "$dir"/BASH-CODING-STANDARD.md
      return 0
    fi
  done
  return 1
}

# Core-tier rule sections plus the Compliance Checking Reference, cut from the
# standard on stdin. Headings inside code fences are code comments, not sections.
extract_core() {
  awk '
    /^```/ { fence = !fence }
    !fence && /^# / { inref = /^# Compliance Checking Reference/; keep = 0 }
    !fence && !inref && /^## / { keep = /^## BCS[0-9]/; buf = "" }
    inref { print; next }
    keep == 1 {
      buf = buf $0 "\n"
      if (/^\*\*Tier:\*\*/) {
        if (/^\*\*Tier:\*\* *core/) { printf "%s", buf; keep = 2 } else keep = 0
      }
      next
    }
    keep == 2 { print }
  '
}

# A shebang decides; without one, the .sh/.bash extension does
is_bash() {
  local -- first=''
  IFS= read -r first < "$1" || :
  if [[ $first == '#!'* ]]; then
    [[ $first =~ [/[:space:]]bash([[:space:]]|$) ]] && return 0
    return 1
  fi
  [[ $1 == *.@(sh|bash) ]] && return 0
  return 1
}

# Cache key for NAME and executable bit XBIT (x or -), content on stdin. Rules,
# mode, name, bit and content all feed it, so a change to any of them (a new
# standard included) is a miss. The bit is there because BCS0106 depends on it
content_key() {
  local -- sum
  sum=$( { printf '%s\n%s\n%s\n%s\n' "$RULES_SHA" "$MODE" "$1" "$2"; cat; } | sha256sum) || return 1
  printf '%s' "${sum%% *}"
}

# Cache key of FILE as it was at SINCE; fails when git has no such file there
prior_key() {
  local -- dir=${1%/*} base=${1##*/} entry xbit=-
  entry=$(git -C "$dir" ls-tree "$SINCE" -- "$base" 2>/dev/null) || return 1
  [[ -n $entry ]] || return 1
  [[ $entry != 100755* ]] || xbit=x
  # A pipe, not $(...): the content must reach the hash with its trailing newlines,
  # exactly as it did when that version was audited. pipefail carries a git failure
  git -C "$dir" show "$SINCE:./$base" 2>/dev/null | content_key "$base" "$xbit"
}

# Context for one target: shellcheck JSON, disable lines and, for DIFF, the prior report and diff
write_context() {
  local -- file=$1 prior_report=$2
  local -i rc=0

  printf '== target\n%s\n\n== shellcheck --format=json -x\n' "$file"
  if command -v shellcheck > /dev/null; then
    # Exit 1 only means it found something; the JSON carries the findings
    shellcheck --format=json -x -- "$file" || rc=$?
    echo
    ((rc < 2)) || printf 'shellcheck failed (exit %d)\n' "$rc"
  else
    echo 'not installed'
  fi

  printf '\n== #bcscheck disable lines (a directive only where # opens a live comment, not heredoc or string content)\n'
  rc=0
  grep -n -- '#bcscheck disable=BCS' "$file" || rc=$?
  ((rc != 1)) || echo 'none'
  ((rc < 2)) || return 1

  [[ -n $prior_report ]] || return 0
  printf '\n== report at %s\n' "$SINCE"
  cat -- "$prior_report" || return 1
  printf '\n== git diff -U10 %s\n' "$SINCE"
  git -C "${file%/*}" diff -U10 "$SINCE" -- "${file##*/}" || return 1
}

main() {
  local -a files=()
  local -- standard rules file key report ctx status prior_report pkey xbit
  local -i n=0 lines rule_count

  while (($#)); do
    case $1 in
      -o|--out)     noarg "$@"; shift; OUT_DIR=$1 ;;
      -f|--full)    MODE=full ;;
      -s|--since)   noarg "$@"; shift; SINCE=$1 ;;
      -h|--help)    usage; return 0 ;;
      -V|--version) printf '%s %s\n' "$SCRIPT_NAME" "$VERSION"; return 0 ;;
      --)           shift; files+=("$@"); break ;;
      -[fhV]?*)     set -- "${1:0:2}" "-${1:2}" "${@:2}"; continue ;;
      -*)           die 22 "Invalid option ${1@Q}" ;;
      *)            files+=("$1") ;;
    esac
    shift
  done
  readonly -- OUT_DIR SINCE MODE

  [[ -n $OUT_DIR ]] || die 8 'Missing -o DIR'
  ((${#files[@]})) || die 8 'No files given'
  [[ $SINCE != -* ]] || die 22 "Invalid git ref ${SINCE@Q}"
  for file in "${files[@]}"; do
    [[ -f $file ]] || die 3 "File not found ${file@Q}"
  done

  standard=$(find_standard) \
    || die 3 'BASH-CODING-STANDARD.md not found in ./data, /usr/local/share/yatti/BCS/data or /usr/share/yatti/BCS/data'
  mkdir -p -- "$OUT_DIR" "$CACHE_DIR" || die 1 "Cannot create ${OUT_DIR@Q} or ${CACHE_DIR@Q}"

  rules=$OUT_DIR/rules-$MODE.md
  if [[ $MODE == core ]]; then
    extract_core < "$standard" > "$rules" || die 1 "Cannot write ${rules@Q}"
  else
    cp -- "$standard" "$rules" || die 1 "Cannot write ${rules@Q}"
  fi
  rule_count=$(grep -c -- '^## BCS[0-9]' "$rules" || :)
  ((rule_count)) || die 1 "No rules found in ${standard@Q}; has its layout changed?"
  RULES_SHA=$(sha256sum < "$rules") || die 1 'sha256sum failed'
  RULES_SHA=${RULES_SHA%% *}
  readonly -- RULES_SHA

  # CONTEXT names are in out, REPORT names in cache; printed once to keep rows short
  printf 'standard\t%s\n' "$standard"
  printf 'rules\t%s\t%d rules\t%d bytes\tmode %s\n' "$rules" "$rule_count" "$(wc -c < "$rules")" "$MODE"
  printf 'out\t%s\ncache\t%s\n' "$(realpath -- "$OUT_DIR")" "$CACHE_DIR"
  printf 'STATUS\tLINES\tFILE\tCONTEXT\tREPORT\n'

  for file in "${files[@]}"; do
    n+=1
    file=$(realpath -- "$file") || die 1 "Cannot resolve ${file@Q}"
    if ! is_bash "$file"; then
      warn "Not a Bash file, skipped ${file@Q}"
      printf 'SKIP\t-\t%s\t-\t-\n' "$file"
      continue
    fi

    xbit=-
    [[ ! -x $file ]] || xbit=x
    key=$(content_key "${file##*/}" "$xbit" < "$file") || die 1 "Cannot hash ${file@Q}"
    report=$CACHE_DIR/$key.txt
    lines=$(wc -l < "$file") || die 1 "Cannot read ${file@Q}"
    if [[ -f $report ]]; then
      printf 'HIT\t%d\t%s\t-\t%s\n' "$lines" "$file" "${report##*/}"
      continue
    fi

    status=MISS
    prior_report=''
    if [[ -n $SINCE ]] && pkey=$(prior_key "$file") && [[ -f $CACHE_DIR/$pkey.txt ]]; then
      status=DIFF
      prior_report=$CACHE_DIR/$pkey.txt
      lines=$(git -C "${file%/*}" diff -U10 "$SINCE" -- "${file##*/}" | wc -l) \
        || die 1 "git diff failed for ${file@Q}"
    fi

    printf -v ctx '%s/%02d-%s.ctx' "$OUT_DIR" "$n" "${file##*/}"
    write_context "$file" "$prior_report" > "$ctx" || die 1 "Cannot write ${ctx@Q}"
    printf '%s\t%d\t%s\t%s\t%s\n' "$status" "$lines" "$file" "${ctx##*/}" "${report##*/}"
  done
}

main "$@"
#fin
