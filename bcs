#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-or-later
#shellcheck disable=SC2015  # BCS idiom: ((cond)) && action ||:
# bcs - Bash Coding Standard CLI toolkit
# Six subcommands for viewing, generating, and checking compliance with the Bash Coding Standard.
# BCS0406 deviation (documented): strict mode runs before the source fence.
# `shopt -s extglob` MUST execute before bash parses the @(...) patterns in
# function bodies below, so it cannot move under the fence without breaking
# `source ./bcs` with a syntax error. The only sourcing consumers are the test
# suites, which run under their own identical strict mode.
#bcscheck disable=BCS0406
set -euo pipefail
# BCS0409: hard Bash 5.2+ floor, in the one slot BCS0101 allows -- after
# set -euo pipefail (safe on any Bash), before shopt (inherit_errexit needs 4.4+).
(( BASH_VERSINFO[0] > 5 || (BASH_VERSINFO[0] == 5 && BASH_VERSINFO[1] >= 2) )) \
  || { >&2 echo "${0##*/}: requires Bash >= 5.2 (have ${BASH_VERSION:-unknown})"; exit 2; }
#bcscheck disable=BCS0406  # sourced by the test suites, as above
shopt -s inherit_errexit extglob nullglob

declare -rx PATH="$HOME"/.local/bin:/usr/local/bin:/usr/bin:/bin

# Script metadata
### VERSION managed by version
declare -r VERSION=2.0.8
###
#shellcheck disable=SC2155  # accepted: declare masks realpath's exit status (BCS0103)
declare -r SCRIPT_PATH=$(realpath -- "$0")
declare -r SCRIPT_DIR=${SCRIPT_PATH%/*} SCRIPT_NAME=${SCRIPT_PATH##*/}

# Global variables
declare -ar BCS_SEARCH_PATHS=(
  "$SCRIPT_DIR"/data
  "${SCRIPT_DIR%/bin}/share/yatti/BCS/data"
  "${PREFIX:-/usr/local}"/share/yatti/BCS/data
  /usr/share/yatti/BCS/data
)

declare -ar VALID_EFFORTS=(low medium high xhigh max)
declare -ar VALID_TEMPLATES=(minimal basic complete library)
declare -ar VALID_TIERS=(core recommended style disabled)
declare -ar VALID_TIER_FILTERS=(core recommended style)

# Rule tier map: BCS#### -> default tier (loaded from section bodies)
declare -A BCS_TIERS=()
# Policy overrides: BCS#### -> override tier (loaded from policy.conf cascade)
declare -A BCS_POLICY=()
declare -i _TIERS_LOADED=0 _POLICY_LOADED=0

# Process-wide temp cleanup registry. Function-local RETURN traps remove
# temps on the normal path, but RETURN does not fire on die/errexit/SIGINT;
# the EXIT/signal-backed net installed by main() guarantees removal on
# abnormal exit too.
declare -a _TMP_CLEANUP=()

# Model alias map -- short names users type that expand to canonical model IDs.
# Override or extend in bcs.conf via `MODEL_ALIASES[name]=canonical-id`.
declare -A MODEL_ALIASES=(
  [opus]=claude-opus-4-8
  [sonnet]=claude-sonnet-4-6
  [haiku]=claude-haiku-4-5
  [flash]=gemini-2.5-flash
  [pro]=gemini-3.1-pro-preview
  [flash-lite]=gemini-3.5-flash-lite
  [gpt5]=gpt-5
  [gpt5-mini]=gpt-5-mini
  [qwen]=qwen3.5:14b
  [qwen-small]=qwen3.5:9b
)

# Effort -> API parameters. EFFORT_TOKENS sets max output tokens (all backends).
# EFFORT_THINKING sets the thinking/reasoning token budget for capable Anthropic
# and Google models. EFFORT_REASONING maps to OpenAI's `reasoning_effort` enum
# for o-series and gpt-5* models. Backends silently skip these on incapable
# models (gating is done by name regex inside each _llm_* function).
#
# Anthropic constraint: `thinking.budget_tokens` MUST be < `max_tokens - 1024`.
# The pairs below satisfy that envelope at every level.
declare -A EFFORT_TOKENS=([low]=4000 [medium]=8000 [high]=24000 [xhigh]=40000 [max]=64000)
declare -A EFFORT_THINKING=([low]=0  [medium]=2000 [high]=6000  [xhigh]=12000 [max]=16000)
declare -A EFFORT_REASONING=([low]=minimal [medium]=low [high]=medium [xhigh]=high [max]=high)

# Text-mode answer contract. CLEAN_LINE is what both prompt builders tell the
# model to print for a compliant script, so that an empty answer is always an
# anomaly (exit 5). ERROR_FINDING_RE recognises a finding header tagged
# [ERROR]: optional Markdown decoration (bullet, numbering, heading, quote,
# bold/italic/backtick), then the tag itself or a BCS code followed by the tag
# within the same header. A sentence that merely mentions the tag does not
# match, so it cannot fail a clean script.
declare -r CLEAN_LINE='No BCS violations found.'
# One contract for both text-mode prompt builders. The fixed shape is what
# ERROR_FINDING_RE and the fixture gate parse; "decide silently" is aimed at
# the measured failure where a model prints a finding and acquits it in the
# same breath, which still reads as [ERROR] to every consumer.
#bcscheck disable=BCS1201 — LLM prompt prose; wrapping degrades instruction quality
declare -r OUTPUT_CONTRACT="Output format (mandatory, machine-parsed):
- One finding per line, exactly: [ERROR|WARN] BCSxxxx line N: <defect, at most 25 words>. Fix: <remedy, at most 25 words>
- Nothing else: no preamble, no headings, no Markdown, no code fences, no notes on rules that pass, no summary.
- Never print a finding you then retract. Decide silently; print confirmed violations only.
- The same rule broken on several lines: one finding per line, or one finding with \"lines N,M,O\".
- If there are no violations, output exactly one line: $CLEAN_LINE"
# Split at the group boundary (BCS1201): leading Markdown decoration, then
# the finding itself. Adjacent quoted fragments concatenate.
declare -r ERROR_FINDING_RE='^[[:space:]]*([-*+>#]+[[:space:]]+|[0-9]+[.)][[:space:]]+)*[*_`]*'\
'(\[ERROR\]|BCS[0-9]{4}[^[:alnum:]].{0,40}\[ERROR\])'

# ---- Messaging System ----
# vecho()/debug() (and DEBUG) belong to the BCS reference messaging suite and
# are kept intentionally even though bcs itself never calls them; BCS0405 is
# suppressed on each definition below.
declare -i VERBOSE=1 DEBUG=0

if [[ -t 1 && -t 2 ]]; then
  declare -r RED=$'\033[0;31m' GREEN=$'\033[0;32m' YELLOW=$'\033[0;33m' \
             CYAN=$'\033[0;36m' BOLD=$'\033[1m' NC=$'\033[0m'
else
  declare -r RED='' GREEN='' YELLOW='' CYAN='' BOLD='' NC=''
fi

_msg() { >&2 printf "$SCRIPT_NAME: $1 %s\n" "${@:2}"; }
error()   { _msg "$RED✗$NC" "$@"; }
die()     { (($# < 2)) || error "${@:2}"; exit "${1:-0}"; }
warn()    { _msg "$YELLOW▲$NC" "$@"; }
#bcscheck disable=BCS0405  # reference messaging suite, kept complete
vecho()   { ((VERBOSE)) || return 0; _msg '' "$@"; }
info()    { ((VERBOSE)) || return 0; _msg "$CYAN◉$NC" "$@"; }
success() { ((VERBOSE)) || return 0; _msg "$GREEN✓$NC" "$@"; }
#bcscheck disable=BCS0405  # reference messaging suite, kept complete
debug()   { ((DEBUG)) || return 0; _msg "$RED⦿$NC" "$@"; }

noarg()   { (($# > 1)) || die 22 "Option ${1@Q} requires an argument"; }

# ---- Configuration and Globals ----

# Load all conf files (cascade: system first, user overrides system)
# Emit bcs.conf cascade paths (system first, user last).
# Extracted as a helper so tests can override it.
_conf_search_paths() {
  # BCS_CONF_DIR overrides the FHS cascade with a single directory -- used for
  # hermetic testing so a real /etc/<name>.conf cannot leak into a test run.
  if [[ -n ${BCS_CONF_DIR:-} ]]; then
    printf '%s\n' "$BCS_CONF_DIR"/"$SCRIPT_NAME".conf
    return 0
  fi
  printf '%s\n' \
    /etc/"$SCRIPT_NAME".conf \
    /etc/"$SCRIPT_NAME"/"$SCRIPT_NAME".conf \
    /usr/local/etc/"$SCRIPT_NAME"/"$SCRIPT_NAME".conf \
    "${XDG_CONFIG_HOME:-$HOME/.config}"/"$SCRIPT_NAME"/"$SCRIPT_NAME".conf
}

read_conf() {
  local -- conf_file mode
  local -i loaded=0
  local -a search_paths=()
  readarray -t search_paths < <(_conf_search_paths)
  for conf_file in "${search_paths[@]}"; do
    [[ -f $conf_file ]] || continue
    # The file is sourced as shell, so loose permissions are an RCE surface.
    # Policy:
    #   - world-writable  -> die 13  (no legitimate setup; always compromise risk)
    #   - group-writable  -> warn    (contextual; may be legitimate in admin groups)
    #   - owner-only      -> silent
    # Octal digit without write bit: 0, 1, 4, 5. With write bit: 2, 3, 6, 7.
    # The ?([0-7]) prefix handles modes with setuid/setgid/sticky bits (e.g. 4755).
    mode=$(stat -c '%a' -- "$conf_file" 2>/dev/null) ||:
    case $mode in
      ''|?([0-7])[0-7][0145][0145])
        : ;; # stat failed, or safe perms
      ?([0-7])[0-7][0-7][2367])
        die 13 "$conf_file: world-writable (mode $mode) -- refusing to source as" \
                "shell; run: chmod o-w ${conf_file@Q}" ;;
      *)
        warn "$conf_file: group-writable mode $mode -- file is sourced as shell; chmod g-w recommended" ;;
    esac
    #shellcheck source=/dev/null
    source -- "$conf_file"
    loaded+=1
  done
  ((loaded))
}

