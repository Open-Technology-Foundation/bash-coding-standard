# ---- Helpers: paths, tiers, policy ----

# Find BASH-CODING-STANDARD.md using FHS-compliant search
_find_bcs_md() {
  local -- path
  for path in "${BCS_SEARCH_PATHS[@]}"; do
    if [[ -f $path/BASH-CODING-STANDARD.md ]]; then
      echo "$path"/BASH-CODING-STANDARD.md
      return 0
    fi
  done
  return 1
}

# Find data directory containing section files
_find_data_dir() {
  local -- path
  for path in "${BCS_SEARCH_PATHS[@]}"; do
    if [[ -d $path ]]; then
      echo "$path"
      return 0
    fi
  done
  return 1
}

# Find md2ansi for formatted output
_find_md2ansi() {
  local -a search_paths=(
    "$SCRIPT_DIR"/examples/md2ansi
    "$SCRIPT_DIR"/lib/md2ansi
  )
  local -- path
  for path in "${search_paths[@]}"; do
    [[ -x $path ]] && { echo "$path"; return 0; } ||:
  done
  command -v md2ansi 2>/dev/null # Falls through to PATH search; non-zero = not found
}

# Tier & policy loading

# Scan section files and populate BCS_TIERS from **Tier:** lines.
# Tier markers live in rule bodies, one line each. Section overview
# headings (BCS##00, e.g. BCS0100) carry no **Tier:** field and are
# silently skipped, leaving BCS_TIERS keyed only by enforceable rules.
_load_tiers() {
  ((_TIERS_LOADED)) && return 0 ||:
  local -- data_dir
  data_dir=$(_find_data_dir) || return 1
  local -- current_code='' line tier
  local -a files=("$data_dir"/[0-9]*.md)
  [[ -d $data_dir/98-user.d ]] && files+=("$data_dir"/98-user.d/*.md) ||:
  # No section files: skip rather than `cat` with no args, which reads stdin.
  ((${#files[@]})) || { _TIERS_LOADED=1; return 0; }
  while IFS= read -r line || [[ -n $line ]]; do
    if [[ $line =~ ^##[[:space:]]+(BCS[0-9]+)[[:space:]] ]]; then
      current_code=${BASH_REMATCH[1]}
    elif [[ -n $current_code && $line =~ ^\*\*Tier:\*\*[[:space:]]+([a-z]+) ]]; then
      tier=${BASH_REMATCH[1]}
      if [[ " ${VALID_TIERS[*]} " == *" $tier "* ]]; then
        BCS_TIERS[$current_code]=$tier
      else
        warn "$current_code: invalid tier ${tier@Q} in section source"
      fi
      current_code=''
    fi
  # 2>/dev/null ||: a section file that vanished between the glob and the read
  # yields no codes, which the caller already treats as "no rules here".
  done < <(cat -- "${files[@]}" 2>/dev/null ||:)
  _TIERS_LOADED=1
}

# Emit policy.conf cascade paths (system first, project-local last).
# Extracted as a helper so tests can override it.
_policy_search_paths() {
  printf '%s\n' \
    /etc/bcs/policy.conf \
    "${XDG_CONFIG_HOME:-$HOME/.config}"/bcs/policy.conf \
    .bcs/policy.conf
}

# Load policy.conf cascade (system -> user -> project; later wins).
# Policy files are parsed line-by-line -- NEVER sourced as shell.
_load_policy() {
  ((_POLICY_LOADED)) && return 0 ||:
  local -a search_paths=()
  readarray -t search_paths < <(_policy_search_paths)
  local -- path line code tier
  local -i lineno
  for path in "${search_paths[@]}"; do
    [[ -f $path && -r $path ]] || continue
    lineno=0
    while IFS= read -r line || [[ -n $line ]]; do
      lineno+=1
      line=${line%%\#*}                         # strip comments
      line=${line#"${line%%[![:space:]]*}"}     # ltrim
      line=${line%"${line##*[![:space:]]}"}     # rtrim
      [[ -n $line ]] || continue
      if [[ $line =~ ^(BCS[0-9]{4})[[:space:]]*=[[:space:]]*([a-z]+)$ ]]; then
        code=${BASH_REMATCH[1]}
        tier=${BASH_REMATCH[2]}
        if [[ " ${VALID_TIERS[*]} " == *" $tier "* ]]; then
          BCS_POLICY[$code]=$tier
        else
          warn "$path:$lineno: invalid tier ${tier@Q} (valid: ${VALID_TIERS[*]})"
        fi
      else
        warn "$path:$lineno: malformed policy line ${line@Q}"
      fi
    done < "$path"
  done
  _POLICY_LOADED=1
}

# Effective tier for a BCS code (policy override wins over default).
# Returns empty string for codes with no tier (section overviews).
_effective_tier() {
  local -- code=$1
  _load_tiers
  _load_policy
  if [[ -n ${BCS_POLICY[$code]:-} ]]; then
    echo "${BCS_POLICY[$code]}"
  else
    echo "${BCS_TIERS[$code]:-}"
  fi
}

# Emit a markdown policy-override block for inclusion in LLM prompts.
# Produces no output when no overrides are defined.
_policy_summary() {
  _load_policy
  ((${#BCS_POLICY[@]})) || return 0
  local -- code
  printf '\n=== POLICY OVERRIDES ===\n'
  printf 'Apply these overrides to the rule tiers defined in the standard:\n'
  while IFS= read -r code; do
    printf -- '- %s: tier = %s\n' "$code" "${BCS_POLICY[$code]}"
  done < <(printf '%s\n' "${!BCS_POLICY[@]}" | sort)
  printf '\nWhen determining severity, use the OVERRIDE tier, not the default.\n'
  printf 'Rules with override tier = "disabled" must NOT be reported.\n'
}

# ---- LLM backends ----

# Dump the raw HTTP response body to $BCS_RESPONSE_DUMP if set.
# cmd_check sets this to a file path so that empty/malformed results
# can be diagnosed without re-running the check.
_dump_response() {
  [[ -n ${BCS_RESPONSE_DUMP:-} ]] || return 0
  # 2>/dev/null ||: the dump is a diagnostic; an unwritable path must not turn
  # a completed check into a failure.
  printf '%s\n' "$1" > "$BCS_RESPONSE_DUMP" 2>/dev/null ||:
}

# Print the standard $1 as the checker should see it: without Section 13,
# which documents the bcs toolchain's own configuration, holds no rule, and
# is ~8% of every prompt. A `---` separator is held back until the heading
# after it shows whether it introduces Section 13 (dropped with it) or
# anything else (printed). User rules and the coda, which follow, survive.
# awk, not parameter expansion: Bash takes ~4 s to cut a string this size.
_checker_standard() {
  awk -- '
    function flush(   i) { for (i = 1; i <= held_n; i++) print held[i]; held_n = 0 }
    /^---$/          { skip = 0; flush(); held[++held_n] = $0; next }
    held_n && /^$/   { held[++held_n] = $0; next }
    held_n           { if (index($0, "# Section 13:") == 1) { held_n = 0; skip = 1; next }
                       flush() }
    !skip            { print }
    END              { flush() }
  ' "$1"
}

# Numeric rank of a tier, for `-M` (at-or-above) comparisons. 0 for anything
# unrecognised, which never satisfies a minimum.
_tier_rank() {
  case $1 in
    core)        echo 3 ;;
    recommended) echo 2 ;;
    style)       echo 1 ;;
    *)           echo 0 ;;
  esac
}

# _filter_by_tier TEXT TIER MIN_TIER -> TEXT with excluded findings removed.
#
# The filters are put in the prompt because they save output tokens, but a
# model that ignores one must not decide what `-T core` means: the severity
# promotion below reads this text, so a leaked style finding turns exit 0 into
# exit 1 for a CI gate that asked for core only. Two lines are deliberately
# never dropped: one naming no BCS code (the clean line), and one whose code
# has no tier -- an invented or section-overview code is the model
# misbehaving, and hiding it would be worse than showing it. JSON mode applies
# the same rules inside _render_json_output, which already holds the tier map.
_filter_by_tier() {
  local -- text=$1 want=$2 minimum=$3 line code tier
  local -i min_rank=0
  [[ -n $want || -n $minimum ]] || { printf '%s' "$text"; return 0; }
  # Prime the tier tables here: _effective_tier memoises, but it runs inside a
  # command substitution below, so without this every finding line would
  # re-read all 15 section files in a fresh subshell (40 findings: 2.54 s
  # against 0.045 s). A failure leaves the tables empty, which the loop reads
  # as "no tier data" and keeps the line -- the documented safe outcome.
  _load_tiers ||:
  _load_policy ||:
  [[ -z $minimum ]] || min_rank=$(_tier_rank "$minimum")
  while IFS= read -r line; do
    code=''
    [[ $line =~ BCS[0-9]{4} ]] && code=${BASH_REMATCH[0]} ||:
    if [[ -n $code ]]; then
      tier=$(_effective_tier "$code")
      if [[ -n $tier ]]; then
        [[ $tier != disabled ]] || continue
        if [[ -n $want ]]; then
          [[ $tier == "$want" ]] || continue
        elif ((min_rank)); then
          (($(_tier_rank "$tier") >= min_rank)) || continue
        fi
      fi
    fi
    printf '%s\n' "$line"
  done <<< "$text"
}

# True when the text-mode answer $1 holds a finding tagged [ERROR].
_has_error_finding() {
  local -- line
  while IFS= read -r line; do
    [[ ! $line =~ $ERROR_FINDING_RE ]] || return 0
  done <<< "$1"
  return 1
}

# Register a path for process-exit cleanup (see _TMP_CLEANUP).
_register_tmp() { _TMP_CLEANUP+=("$1"); }

# Remove every registered temp path. Installed as the EXIT trap by main() so
# temps are reclaimed even when a function aborts via die/errexit/SIGINT,
# where its local RETURN trap never fires.
_cleanup_tmps() {
  trap - INT TERM EXIT   # BCS0603: prevent re-entry during cleanup
  local -- p
  for p in "${_TMP_CLEANUP[@]}"; do
    [[ -z $p ]] || rm -rf -- "$p" 2>/dev/null ||:
  done
}

# ---- JSON output helpers ----

# Strip optional markdown code fences from an LLM response. Used by JSON
# mode for backends without native JSON-mode parameters (Anthropic Messages
# API, Claude Code CLI). Removes ``` or ```json at start and ``` at end,
# plus surrounding whitespace.
_strip_json_fences() {
  local -- s=$1
  s=${s#"${s%%[![:space:]]*}"}
  s=${s%"${s##*[![:space:]]}"}
  [[ $s != '```'* ]] || { s=${s#'```'}; s=${s#json}; s=${s#$'\n'}; }
  [[ $s != *'```' ]] || { s=${s%'```'}; s=${s%$'\n'}; }
  s=${s#"${s%%[![:space:]]*}"}
  s=${s%"${s##*[![:space:]]}"}
  printf '%s' "$s"
}

# Authoritative tier for every BCS code a finding array cites, as a JSON
# object: {"BCS0101": "core", "BCS1203": "style"}. Codes with no tier of their
# own -- section overviews, a code the model invented, a user rule this tree
# does not carry -- are simply absent from the map, and the caller leaves those
# findings labelled as the model labelled them rather than replacing one guess
# with another. Reads through _effective_tier, so a policy.conf override is
# honoured here exactly as it is by `bcs codes`.
_tier_map_json() {
  local -- arr=$1 code tier
  local -a pairs=()
  # No reachable section sources (no ./data, nothing installed): an empty map
  # leaves every level as received. Losing the correction is survivable; dying
  # in the middle of rendering a result the user already paid for is not.
  _load_tiers || { printf '{}'; return 0; }
  # The caller has already schema-validated the array, so jq cannot fail on
  # shape here. A jq that dies anyway feeds the loop nothing and leaves the map
  # empty, which the caller reads as "no tier data" -- the same safe outcome as
  # an uninstalled standard, and better than aborting a paid-for result.
  while IFS= read -r code; do
    [[ -n $code ]] || continue
    tier=$(_effective_tier "$code")
    [[ -n $tier ]] || continue
    pairs+=("$code" "$tier")
  done < <(jq -r '[.[].bcsCode] | unique | .[]' <<< "$arr" 2>/dev/null ||:)
  ((${#pairs[@]})) || { printf '{}'; return 0; }
  jq -n '$ARGS.positional
         | [range(0; length; 2) as $i | {key: .[$i], value: .[$i + 1]}]
         | from_entries' --args "${pairs[@]}"
}

# Validate a bare JSON array of findings and wrap it in the top-level
# envelope with meta fields. Emits the final JSON object on stdout.
# Returns non-zero and emits nothing on validation failure.
#
# Arguments:
#   $1 raw LLM response (may include fences)
#   $2 absolute script path
#   $3 backend name
#   $4 model name (resolved)
#   $5 effort level
#   $6 strict (0|1)
#   $7 elapsed seconds
#   $8 tier filter (-T), $9 minimum tier (-M); empty means no filter
#   $7 elapsed seconds
_render_json_output() {
  local -- raw=$1 script_file=$2 backend=$3 model=$4 effort=$5
  local -i strict=$6 elapsed_s=$7
  local -- want=${8:-} minimum=${9:-}
  local -i min_rank=0
  [[ -z $minimum ]] || min_rank=$(_tier_rank "$minimum")
  local -- cleaned arr
  cleaned=$(_strip_json_fences "$raw")
  [[ -n $cleaned ]] || return 1
  # Normalize to a bare array. OpenAI's json_object mode forbids a top-level
  # array, so the model answers with an object instead. _llm_openai names the
  # wrapper it wants, {"findings": [...]}; the other shapes seen in the wild are
  # still accepted: a similar wrapper key, one bare finding object, {} for
  # nothing to report, and the array spelled with numeric keys ({"0": {...}}).
  # Anything else is invalid.
  if jq -e 'type == "array"' <<< "$cleaned" &>/dev/null; then
    arr=$cleaned
  elif jq -e 'type == "object"' <<< "$cleaned" &>/dev/null; then
    arr=$(jq -c 'if has("line") and has("level") and has("bcsCode") then [.]
                 elif length == 0 then []
                 elif (keys | all(test("^[0-9]+$"))) then
                   [to_entries | sort_by(.key | tonumber) | .[].value] | flatten(1)
                 else (.findings // .comments // .violations // .results // empty)
                      | select(type == "array")
                 end' <<< "$cleaned" 2>/dev/null) ||:
    [[ -n $arr ]] || return 1
  else
    return 1
  fi
  # Validate every element has the required finding keys.
  jq -e 'all(.[]; type == "object"
           and has("line") and has("level") and has("bcsCode"))' \
    <<< "$arr" &>/dev/null || return 1
  local -- strict_bool tier_map
  ((strict)) && strict_bool=true || strict_bool=false
  tier_map=$(_tier_map_json "$arr")
  jq -n \
    --arg tool 'bcs' \
    --arg version "$VERSION" \
    --arg file "$script_file" \
    --arg backend "$backend" \
    --arg model "$model" \
    --arg effort "$effort" \
    --argjson strict "$strict_bool" \
    --argjson elapsed_s "$elapsed_s" \
    --argjson comments "$arr" \
    --argjson tiers "$tier_map" \
    --arg want "$want" \
    --argjson min_rank "$min_rank" \
    `# same ordering as _tier_rank; VALID_TIERS holds no fourth` \
    --argjson rank '{"core": 3, "recommended": 2, "style": 1}' \
    '{source: "bcs",
      meta: {tool: $tool, version: $version, file: $file, backend: $backend,
             model: $model, effort: $effort, strict: $strict, elapsed_s: $elapsed_s},
      comments: ($comments
        | map(. + {file: $file,
                   column: (.column // 1),
                   endLine: (.endLine // .line),
                   endColumn: (.endColumn // 1),
                   fix: null,
                   fixSuggestion: (.fixSuggestion // "")}
              | if $tiers[.bcsCode] then .tier = $tiers[.bcsCode] else . end
              | if $tiers[.bcsCode] then
                  .level = (if $strict then "error"
                            elif .tier == "core" then "error"
                            else "warning" end)
                else . end)
        | map(select(.tier != "disabled"))
        | map(select(($tiers[.bcsCode] // "") as $t
                     | if $t == "" then true
                       elif $want != "" then $t == $want
                       elif $min_rank > 0 then ($rank[$t] // 0) >= $min_rank
                       else true end)))}' \
    || return 1
}

# Expand a model alias (e.g. "opus") to its canonical ID (e.g. "claude-opus-4-8").
# Returns the input unchanged when no alias matches -- direct model IDs and
# unknown names pass straight through to backend resolution.
_expand_alias() { printf '%s\n' "${MODEL_ALIASES[$1]:-$1}"; }

# Sniff backend from a direct model name. Used by cmd_check() to route an
# alias-expanded canonical model ID to the right LLM backend. Matches vendor
# prefixes; anything unrecognised falls back to ollama.
#
# ▲ LOAD-BEARING CASE ORDER ▲
# The `claude-code*` case MUST precede `claude-*`. If reordered, the
# claude-code sentinel routes to the Anthropic Messages API instead of
# the Claude Code CLI -- silently, with no error -- because `claude-*`
# also matches `claude-code`. Do not reorder these cases.
_sniff_backend() {
  case $1 in
    claude|claude:*|claude-code|claude-code:*)
                      echo claude ;;
    claude-*)         echo anthropic ;;
    gemini-*)         echo google ;;
    gpt-*|o[0-9]*)    echo openai ;;
    *)                echo ollama ;;
  esac
}

# Run shellcheck over the script-under-check and return its JSON report.
# Never aborts the caller: missing binary or parse failure emits empty output
# so cmd_check() can proceed without static-analysis context.
_run_shellcheck() {
  local -- file=$1 json=''
  local -i rc=0
  command -v shellcheck &>/dev/null || {
    info 'shellcheck not in PATH; skipping static-analysis context'
    return 0
  }
  # exit 0 = clean, 1 = findings present (both fine); >=2 = parse failure.
  # Capture rc via fallback so set -e does not trip on the expected exit 1.
  json=$(shellcheck --format=json -x -- "$file" 2>/dev/null) || rc=$?
  ((rc <= 1)) || { warn "shellcheck failed (exit $rc); continuing without context"; return 0; }
  printf '%s\n' "$json"
}

# Wrap a shellcheck JSON report in a markdown block suitable for prepending
# to the LLM user prompt. Returns empty string when the report is empty or
# `[]` so clean scripts never contribute an empty section to the prompt.
_render_shellcheck_block() {
  local -- json=$1
  [[ -z $json || $json == '[]' ]] && return 0
  cat <<MD
## Static analysis context (shellcheck --format=json -x)

The following findings come from a deterministic static analyser. Use
them as supporting context for your BCS review; do not re-emit them as
BCS findings unless they map to a specific BCS rule.

\`\`\`json
$json
\`\`\`
MD
}

# Extract and concatenate every text block from an Anthropic Messages API
# response body (read on stdin). With extended thinking enabled the first
# content block is a `thinking` block (no `.text`), so the old
# `.content[0].text` read returned empty and the checker silently passed
# everything; select blocks by the presence of `.text` instead.
_extract_anthropic_text() {
  jq -r '[.content[]? | select(.text != null) | .text] | join("")'
}

# LLM backend: Anthropic Messages API
_llm_anthropic() {
  local -- model=$1 effort=$2 sys=$3 usr=$4
  [[ -n ${ANTHROPIC_API_KEY:-} ]] || die 18 'ANTHROPIC_API_KEY not set'
  local -i max_tokens=${EFFORT_TOKENS[$effort]}
  local -i think_budget=${EFFORT_THINKING[$effort]:-0}

  # Capability gating. Anthropic thinking has two incompatible shapes and a
  # model that is sent the wrong one answers HTTP 400, so this lists only
  # what was probed live (2026-09-18) -- an unknown model gets no thinking
  # rather than a guess:
  #   enabled  + budget_tokens         haiku-4-5, sonnet-4-5/4-6, opus-4-5/4-6
  #   adaptive + output_config.effort  opus-4-7/4-8 and every Claude 5
  # opus-4-6 and sonnet-4-6 take either; they keep the explicit budget so the
  # -e scale stays comparable with the other backends. The `enabled` form also
  # requires budget_tokens < max_tokens - 1024 (the current pairs respect it).
  # The Claude 5 pattern is family-anchored so that a 4.x with minor 5
  # (claude-haiku-4-5) cannot match it.
  local -- thinking_json='null' effort_json='null'
  case $model in
    *opus-4-7*|*opus-4-8*|claude-+([a-z])-5|claude-+([a-z])-5-*)
        # The API takes exactly BCS's own five effort words, so pass it through.
        thinking_json='{"type":"adaptive"}'
        effort_json=$(jq -n --arg e "$effort" '{effort: $e}') \
          || die 1 'Failed to build effort payload' ;;
    *haiku-4-5*|*sonnet-4-5*|*sonnet-4-6*|*opus-4-5*|*opus-4-6*)
        if ((think_budget > 0)); then
          thinking_json=$(jq -n --argjson b "$think_budget" \
            '{type: "enabled", budget_tokens: $b}') \
            || die 1 'Failed to build thinking payload'
        fi ;;
  esac

  # Anthropic Messages API has no native JSON-mode flag; rely on prompt
  # discipline plus _strip_json_fences fallback applied by cmd_check.
  # The system prompt (the standard minus Section 13, ~32k tokens) is identical across
  # calls, so mark it with ephemeral cache_control: repeat checks within the
  # server-side cache TTL (~5 min, refreshed on use) read it from cache --
  # much cheaper and a faster prefill. All current claude-* models support
  # prompt caching and the standard far exceeds the minimum cacheable size.
  local -- payload
  payload=$(jq -n \
    --arg model "$model" \
    --argjson max_tokens "$max_tokens" \
    --argjson thinking "$thinking_json" \
    --argjson effort_cfg "$effort_json" \
    --arg system "$sys" \
    --arg user "$usr" \
    '{model: $model, max_tokens: $max_tokens,
      system: [{type: "text", text: $system,
                cache_control: {type: "ephemeral"}}],
      messages: [{role: "user", content: $user}]}
     + ($thinking | if . == null then {} else {thinking: .} end)
     + ($effort_cfg | if . == null then {} else {output_config: .} end)') \
    || die 1 'Failed to build JSON payload'

  local -- raw body
  local -i http_code
  # Pass the secret header via --config from a builtin-printf process
  # substitution so the key never appears in curl's argv (visible in `ps`
  # and /proc/PID/cmdline to other local users).
  raw=$(curl -s --max-time 300 -w $'\n%{http_code}' \
    --config <(printf 'header = "x-api-key: %s"\n' "$ANTHROPIC_API_KEY") \
    -H 'Content-Type: application/json' \
    -H 'anthropic-version: 2023-06-01' \
    -d @- \
    'https://api.anthropic.com/v1/messages' <<< "$payload") || die 5 'Anthropic API connection failed'
  http_code=${raw##*$'\n'}
  body=${raw%$'\n'"$http_code"}
  _dump_response "$body"
  if ! ((http_code >= 200 && http_code < 300)); then
    local -- errmsg
    errmsg=$(jq -r '.error.message // empty' <<< "$body" 2>/dev/null) ||:
    die 5 "Anthropic API error (HTTP $http_code)" ${errmsg:+"$errmsg"}
  fi

  local -- text
  text=$(_extract_anthropic_text <<< "$body") || die 5 'Failed to parse Anthropic response'
  [[ -n $text ]] || die 5 'Anthropic API returned no text content (response had only thinking blocks or was empty)'
  printf '%s\n' "$text"
  # input_tokens excludes cached prefix tokens; report cache traffic
  # separately so users can confirm prompt caching is engaging.
  echo "___TOKENS___ $(jq -r '"in=\(.usage.input_tokens // 0) out=\(.usage.output_tokens // 0)"
    + (if (.usage.cache_read_input_tokens // 0) > 0
       then " cache_read=\(.usage.cache_read_input_tokens)" else "" end)
    + (if (.usage.cache_creation_input_tokens // 0) > 0
       then " cache_write=\(.usage.cache_creation_input_tokens)" else "" end)' <<< "$body")"
}

# LLM backend: Ollama chat API
_llm_ollama() {
  local -- model=$1 effort=$2 sys=$3 usr=$4
  local -- ollama_host=${OLLAMA_HOST:-localhost:11434}
  local -i num_predict=${EFFORT_TOKENS[$effort]}

  # Ollama truncates the prompt to the server default (4096 tokens) unless
  # options.num_ctx says otherwise, and the standard alone is ~33k tokens:
  # without it the model never sees the rules. keep_alive holds the model in
  # memory between checks; an integer is sent as seconds (-1 = forever).
  local -- keep_alive=${BCS_OLLAMA_KEEP_ALIVE:-30m}
  [[ ${BCS_OLLAMA_NUM_CTX:-40960} =~ ^[1-9][0-9]*$ ]] \
    || die 22 "Invalid BCS_OLLAMA_NUM_CTX ${BCS_OLLAMA_NUM_CTX@Q} (expected a positive integer)"
  local -i num_ctx=${BCS_OLLAMA_NUM_CTX:-40960}
  # ~4 chars/token is a floor for this prompt, so truncation here is certain.
  (((${#sys} + ${#usr}) / 4 <= num_ctx)) \
    || warn "Prompt exceeds BCS_OLLAMA_NUM_CTX=$num_ctx tokens; Ollama will truncate it"

  # Native JSON mode via "format": "json" (supported by qwen2.5+, llama3.1+,
  # gemma2+). When BCS_JSON_MODE=1, forces the model to emit only valid JSON.
  local -- payload
  if ((${BCS_JSON_MODE:-0})); then
    payload=$(jq -n \
      --arg model "$model" \
      --argjson num_predict "$num_predict" \
      --argjson num_ctx "$num_ctx" \
      --arg keep_alive "$keep_alive" \
      --arg system "$sys" \
      --arg user "$usr" \
      '{model: $model, stream: false, format: "json",
        keep_alive: ($keep_alive | tonumber? // $keep_alive),
        options: {num_predict: $num_predict, num_ctx: $num_ctx},
        messages: [{role: "system", content: $system}, {role: "user", content: $user}]}') \
      || die 1 'Failed to build JSON payload'
  else
    payload=$(jq -n \
      --arg model "$model" \
      --argjson num_predict "$num_predict" \
      --argjson num_ctx "$num_ctx" \
      --arg keep_alive "$keep_alive" \
      --arg system "$sys" \
      --arg user "$usr" \
      '{model: $model, stream: false,
        keep_alive: ($keep_alive | tonumber? // $keep_alive),
        options: {num_predict: $num_predict, num_ctx: $num_ctx},
        messages: [{role: "system", content: $system}, {role: "user", content: $user}]}') \
      || die 1 'Failed to build JSON payload'
  fi

  local -- raw body
  local -i http_code
  raw=$(curl -s --max-time 600 -w $'\n%{http_code}' \
    -H 'Content-Type: application/json' \
    -d @- \
    "http://$ollama_host/api/chat" <<< "$payload") || die 5 'Ollama API connection failed'
  http_code=${raw##*$'\n'}
  body=${raw%$'\n'"$http_code"}
  _dump_response "$body"
  if ! ((http_code >= 200 && http_code < 300)); then
    local -- errmsg
    errmsg=$(jq -r '.error // empty' <<< "$body" 2>/dev/null) ||:
    die 5 "Ollama API error (HTTP $http_code)" ${errmsg:+"$errmsg"}
  fi

  local -- content
  content=$(jq -r '.message.content // empty' <<< "$body")
  # Strip <think>...</think> tags from qwen3 models
  [[ $content != *'</think>'* ]] || { content=${content##*</think>}; content=${content#$'\n'}; }
  echo "$content"
  echo "___TOKENS___ $(jq -r '"in=\(.prompt_eval_count // 0) out=\(.eval_count // 0)"' <<< "$body")"
}

# LLM backend: OpenAI chat completions API
_llm_openai() {
  local -- model=$1 effort=$2 sys=$3 usr=$4
  [[ -n ${OPENAI_API_KEY:-} ]] || die 18 'OPENAI_API_KEY not set'
  local -i max_tokens=${EFFORT_TOKENS[$effort]}

  # Capability gating: o-series and gpt-5* accept reasoning_effort. Older
  # GPT-4-class models (gpt-4, gpt-4.1, gpt-4o*) reject it with HTTP 400, so
  # match `gpt-4*` first to short-circuit -- the broader prefix already
  # subsumes gpt-4.1, gpt-4o, gpt-4o-mini, etc.
  local -- reasoning=''
  case $model in
    gpt-4*)         : ;;
    o[0-9]*|gpt-5*) reasoning=${EFFORT_REASONING[$effort]:-} ;;
    *)              : ;;
  esac

  # Native JSON mode via response_format:{type:"json_object"} (GPT-4+).
  # System/user prompt must mention "JSON" somewhere -- our JSON-mode prompt
  # satisfies that. Empty $reasoning means the field is omitted entirely.
  #
  # json_object forbids a top-level array, yet the shared prompt asks for one.
  # Left to improvise, the model spelled the array as a bare finding, as {},
  # or as {"0": {...}} -- a different shape from run to run. Name the wrapper.
  local -- payload
  if ((${BCS_JSON_MODE:-0})); then
    usr+=$'\n\nThis API requires a JSON object at the top level. Return exactly'
    usr+=$' {"findings": [ ... ]} whose value is the array described above'
    usr+=$' (an empty array when there are no findings).'
    payload=$(jq -n \
      --arg model "$model" \
      --argjson max_tokens "$max_tokens" \
      --arg reasoning "$reasoning" \
      --arg system "$sys" \
      --arg user "$usr" \
      '{model: $model, max_completion_tokens: $max_tokens,
        response_format: {type: "json_object"},
        messages: [{role: "system", content: $system}, {role: "user", content: $user}]}
       + (if $reasoning == "" then {} else {reasoning_effort: $reasoning} end)') \
      || die 1 'Failed to build JSON payload'
  else
    payload=$(jq -n \
      --arg model "$model" \
      --argjson max_tokens "$max_tokens" \
      --arg reasoning "$reasoning" \
      --arg system "$sys" \
      --arg user "$usr" \
      '{model: $model, max_completion_tokens: $max_tokens,
        messages: [{role: "system", content: $system}, {role: "user", content: $user}]}
       + (if $reasoning == "" then {} else {reasoning_effort: $reasoning} end)') \
      || die 1 'Failed to build JSON payload'
  fi

  local -- raw body
  local -i http_code
  # Secret header via --config (builtin printf) keeps the key out of argv.
  raw=$(curl -s --max-time 300 -w $'\n%{http_code}' \
    --config <(printf 'header = "Authorization: Bearer %s"\n' "$OPENAI_API_KEY") \
    -H 'Content-Type: application/json' \
    -d @- \
    'https://api.openai.com/v1/chat/completions' <<< "$payload") || die 5 'OpenAI API connection failed'
  http_code=${raw##*$'\n'}
  body=${raw%$'\n'"$http_code"}
  _dump_response "$body"
  if ! ((http_code >= 200 && http_code < 300)); then
    local -- errmsg
    errmsg=$(jq -r '.error.message // empty' <<< "$body" 2>/dev/null) ||:
    die 5 "OpenAI API error (HTTP $http_code)" ${errmsg:+"$errmsg"}
  fi

  # An HTTP 200 with no text is an anomaly (e.g. finish_reason=length: the
  # reasoning pass consumed the whole output budget), never a clean pass.
  local -- text
  text=$(jq -r '.choices[0].message.content // empty' <<< "$body") \
    || die 5 'Failed to parse OpenAI response'
  [[ -n $text ]] || die 5 'OpenAI API returned no text content' \
    "finish_reason=$(jq -r '.choices[0].finish_reason // "unknown"' <<< "$body" 2>/dev/null ||:)"
  printf '%s\n' "$text"
  echo "___TOKENS___ $(jq -r '"in=\(.usage.prompt_tokens // 0) out=\(.usage.completion_tokens // 0)"' <<< "$body")"
}

# LLM backend: Google Gemini API
_llm_google() {
  local -- model=$1 effort=$2 sys=$3 usr=$4
  local -- api_key=${GOOGLE_API_KEY:-${GEMINI_API_KEY:-}}
  [[ -n $api_key ]] || die 18 'GOOGLE_API_KEY or GEMINI_API_KEY not set'
  local -i max_tokens=${EFFORT_TOKENS[$effort]}
  local -i think_budget=${EFFORT_THINKING[$effort]:-0}

  # Capability gating: thinkingBudget lives under
  # generationConfig.thinkingConfig (camelCase, nested). The gate lists only
  # what the API was seen to accept (probed 2026-09-17): the 2.5 family,
  # gemini-3.5-flash and gemini-3.5-flash-lite. A zero budget is never sent --
  # gemini-3.5-flash-lite answers it with HTTP 400, as the retired
  # gemini-2.5-flash-lite did any thinkingConfig. Unlisted models (e.g.
  # gemini-3.1-pro-preview, unprobed) get no budget, which every model accepts.
  local -i emit_thinking=0
  case $model in
    gemini-2.5-flash-lite*)     : ;;
    *-2.5-*|gemini-3.5-flash*)  ((think_budget == 0)) || emit_thinking=1 ;;
    *)                          : ;;
  esac

  # Native JSON mode via generationConfig.response_mime_type. Gemini 1.5+
  # supports "application/json" to force a structured-output response.
  local -- payload
  if ((${BCS_JSON_MODE:-0})); then
    payload=$(jq -n \
      --argjson max_tokens "$max_tokens" \
      --argjson think_budget "$think_budget" \
      --argjson emit_thinking "$emit_thinking" \
      --arg system "$sys" \
      --arg user "$usr" \
      '{systemInstruction: {parts: [{text: $system}]},
        contents: [{role: "user", parts: [{text: $user}]}],
        generationConfig: ({maxOutputTokens: $max_tokens,
                            response_mime_type: "application/json"}
                           + (if $emit_thinking == 1
                              then {thinkingConfig: {thinkingBudget: $think_budget}}
                              else {} end))}') \
      || die 1 'Failed to build JSON payload'
  else
    payload=$(jq -n \
      --argjson max_tokens "$max_tokens" \
      --argjson think_budget "$think_budget" \
      --argjson emit_thinking "$emit_thinking" \
      --arg system "$sys" \
      --arg user "$usr" \
      '{systemInstruction: {parts: [{text: $system}]},
        contents: [{role: "user", parts: [{text: $user}]}],
        generationConfig: ({maxOutputTokens: $max_tokens}
                           + (if $emit_thinking == 1
                              then {thinkingConfig: {thinkingBudget: $think_budget}}
                              else {} end))}') \
      || die 1 'Failed to build JSON payload'
  fi

  local -- url=https://generativelanguage.googleapis.com/v1beta/models/"$model":generateContent
  local -- raw body
  local -i http_code
  # Secret header via --config (builtin printf) keeps the key out of argv.
  raw=$(curl -s --max-time 300 -w $'\n%{http_code}' \
    --config <(printf 'header = "x-goog-api-key: %s"\n' "$api_key") \
    -H 'Content-Type: application/json' \
    -d @- \
    "$url" <<< "$payload") || die 5 'Google API connection failed'
  http_code=${raw##*$'\n'}
  body=${raw%$'\n'"$http_code"}
  _dump_response "$body"
  if ! ((http_code >= 200 && http_code < 300)); then
    local -- errmsg
    errmsg=$(jq -r '.error.message // empty' <<< "$body" 2>/dev/null) ||:
    die 5 "Google API error (HTTP $http_code)" ${errmsg:+"$errmsg"}
  fi

  # Join every text part: a multi-part answer must be neither truncated to
  # its first part nor misread as empty. No text at all is an anomaly (safety
  # block, MAX_TOKENS spent on thinking), never a clean pass.
  local -- text
  text=$(jq -r '[.candidates[0].content.parts[]? | select(.thought != true)
                 | .text // empty] | join("")' <<< "$body") \
    || die 5 'Failed to parse Google response'
  [[ -n $text ]] || die 5 'Google API returned no text content' \
    "finishReason=$(jq -r '.candidates[0].finishReason
                           // .promptFeedback.blockReason
                           // "unknown"' <<< "$body" 2>/dev/null ||:)"
  printf '%s\n' "$text"
  local -- tkn
  tkn=$(jq -r \
    '"in=\(.usageMetadata.promptTokenCount // 0) out=\(.usageMetadata.candidatesTokenCount // 0)"' \
    <<< "$body")
  echo "___TOKENS___ $tkn"
}

# LLM backend: Claude Code CLI. Builds the prompt with @file references
# (resolved by the CLI itself) rather than inlining the standard or script,
# and runs `claude -p` from a clean temp dir with bypassPermissions.
_llm_claude_cli() {
  local -- model=$1 effort=$2 bcs_file=$3 script_file=$4
  local -i strict=$5
  local -- tier_instr=${6:-} filter_instr=${7:-} policy_text=${8:-}
  local -- shellcheck_block=${9:-}
  command -v claude &>/dev/null || die 18 'Claude CLI required for claude backend'

  # cd to clean temp dir -- prevents claude from loading local CLAUDE.md
  local -- check_dir
  check_dir=$(mktemp -d -t 'bcs-XXXXX') || die 1 'Failed to create temp dir'
  _register_tmp "$check_dir"
  # Capture the return directory in a local and reference it from a
  # single-quoted trap (expanded at trap time, not definition time) so a
  # cwd path containing shell metacharacters cannot inject commands.
  local -- ret_dir=$PWD
  trap 'cd -- "$ret_dir" 2>/dev/null ||:; rm -rf -- "$check_dir"' RETURN
  # The CLI's stderr goes to the response dump, not /dev/null: an auth or
  # quota failure is otherwise a bare non-zero exit. Anchor a relative dump
  # path now, before the cd below changes what it would resolve against.
  local -- err_file=${BCS_RESPONSE_DUMP:-/dev/null}
  [[ $err_file == /* ]] || err_file=$ret_dir/$err_file
  # return, not die: the RETURN trap above is what removes the temp dir.
  cd -- "$check_dir" \
    || { error "Failed to enter temp dir ${check_dir@Q}"; return 5; }
  [[ ! -d /run/user/"$EUID" ]] || declare -x TMPDIR=/run/user/"$EUID"

  # The CLI reads the standard through an @file reference: give it the
  # checker's copy (no Section 13), written into the temp dir it runs from.
  local -- std_file="$check_dir"/BASH-CODING-STANDARD.md
  # return, not die: only a return fires the RETURN trap that removes the dir.
  _checker_standard "$bcs_file" > "$std_file" \
    || { error 'Failed to write the checker standard'; return 5; }
  # Likewise the script: a copy inside the temp dir, never the original. The
  # agent has Read/Grep/Glob, and a script's neighbours are none of its
  # business (a test fixture sits beside the manifest that names its defect).
  local -- script_copy="$check_dir"/${script_file##*/}
  cp -- "$script_file" "$script_copy" \
    || { error 'Failed to write the checker copy of the script'; return 5; }

  local -- prompt
  if ((${BCS_JSON_MODE:-0})); then
    prompt="You are a Bash script compliance validator emitting structured JSON output.

Analyze @$script_copy against the Bash Coding Standard defined in @$std_file.

$tier_instr

Level mapping for JSON output:
- Tier \"core\"        -> level \"error\"
- Tier \"recommended\" -> level \"warning\"
- Tier \"style\"       -> level \"warning\"
- Tier \"disabled\"    -> OMIT entirely

Respect inline suppression: \`#bcscheck disable=BCSxxxx\` exempts the next line/block.

Return a JSON array of finding objects. Each finding object has this shape:
  {
    \"line\": <1-indexed integer>,
    \"endLine\": <1-indexed integer, same as line if single-line>,
    \"level\": \"error\" | \"warning\" | \"info\",
    \"code\": <integer, BCS code without the BCS prefix (e.g. 101 for BCS0101)>,
    \"bcsCode\": \"BCS####\",
    \"tier\": \"core\" | \"recommended\" | \"style\",
    \"message\": \"<one sentence describing the violation>\",
    \"fixSuggestion\": \"<human-readable remediation advice>\"
  }

Example of a valid response (one finding):
[
  {
    \"line\": 4,
    \"endLine\": 4,
    \"level\": \"error\",
    \"code\": 101,
    \"bcsCode\": \"BCS0101\",
    \"tier\": \"core\",
    \"message\": \"Missing set -euo pipefail strict mode declaration.\",
    \"fixSuggestion\": \"Add 'set -euo pipefail' and 'shopt -s inherit_errexit' right after the shebang.\"
  }
]

Return ONLY the JSON array. No markdown code fences. No commentary. No preamble.
If there are no findings, return []."
  else
    prompt="You are a Bash script compliance validator.

Analyze @$script_copy against the Bash Coding Standard defined in @$std_file.

$tier_instr

$OUTPUT_CONTRACT

Respect inline suppression: eg, #bcscheck disable=BCS0101 exempts the next line/block."
  fi

  [[ -z $filter_instr ]] || prompt+=$'\n\n'"$filter_instr"
  [[ -z $policy_text ]] || prompt+=$'\n'"$policy_text"
  [[ -z $shellcheck_block ]] || prompt+=$'\n\n'"$shellcheck_block"
  if ((strict)); then
    if ((${BCS_JSON_MODE:-0})); then
      prompt+=$'\n\nSTRICT MODE: Map recommended/style violations to level "error" instead of "warning".'
    else
      prompt+=$'\n\nSTRICT MODE: Treat all warnings as [ERROR].'
    fi
  fi

  # Read-only toolset: the checker only needs to read @script and @standard.
  # Without this, the bypassPermissions agent can shell out -- observed in the
  # wild recursively invoking bcscheck (stacked LLM calls, cache-laundered
  # results) instead of analyzing directly.
  #
  # --strict-mcp-config with no --mcp-config loads no MCP server at all: the
  # user's servers (93 tools, ~50k tokens per turn, measured) are dead weight
  # here and a needless attack surface under bypassPermissions.
  #
  # --effort is pinned to the CLI's lowest native level whatever -e says. The
  # CLI maps its effort to a thinking budget of its own: `medium` spent ~20k
  # thinking tokens per check (91% of wall time, 8-12x the API backends) for
  # no measured gain. On this backend -e changes nothing else either.
  local -a claude_args=(--model "$model" --permission-mode bypassPermissions
                        --tools 'Read,Grep,Glob' --strict-mcp-config
                        --effort low)
  [[ $effort == low ]] \
    || info "CLI backend always runs at its lowest native effort; -e $effort has no effect"

  # BCS0202/BCS0204: local -x exports to the claude child for this function's
  # lifetime without leaking into the global scope.
  local -x CLAUDE_CODE_USE_OAUTH=1
  # Recursion guard sentinel, checked at the top of cmd_check: any bcs check
  # spawned from inside this session (agent shelling out, user hook) dies
  # immediately instead of nesting LLM calls. Defense in depth alongside the
  # read-only --tools set above.
  local -x BCS_CHECK_ACTIVE=1
  unset ANTHROPIC_API_KEY
  # SC1007: `CLAUDECODE= claude ...` clears the env var for one command;
  # the empty-RHS assignment is intentional, not a typo.
  local -i rc=0
  #shellcheck disable=SC1007  # CLAUDECODE= is deliberately empty: clears the nesting guard
  CLAUDECODE= claude "${claude_args[@]}" -p "$prompt" 2>"$err_file" || rc=$?
  ((rc)) || return 0
  # A failed CLI is a backend failure (5), never exit 1: callers read 1 as
  # "ERROR findings found". return, not die, so the RETURN trap still cleans up.
  local -- err_tail=''
  [[ ! -s $err_file ]] || err_tail=$(tail -n 5 -- "$err_file")
  error "Claude Code CLI failed (exit $rc)" ${err_tail:+"$err_tail"}
  return 5
}

